RESULTAT('%SCEN%','SLKK','INNT','VERD') = RESULTAT('%SCEN%','SLKK','VARE','INTV') + RESULTAT('%SCEN%','SLKK','VARE','EKSV')+
                                 RESULTAT('%SCEN%','SLKK','VARE','TFRKV');
RESULTAT('%SCEN%','SLKK',VARE,'OMSV') = SUM(STEPRES, RESNORGE('SLKK',VARE,'OMSV',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK',VARE,'OMSM') $ RESULTAT('%SCEN%','SLKK',VARE,'OMSV') = SUM(STEPRES, RESNORGE('PROD',VARE,'MNGD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK',VARE,'OMSP') $ RESULTAT('%SCEN%','SLKK',VARE,'OMSM') = RESULTAT('%SCEN%','SLKK',VARE,'OMSV') / RESULTAT('%SCEN%','SLKK',VARE,'OMSM');
RESULTAT('%SCEN%','SLKK','VARE','OMSV') = SUM(VARE, RESULTAT('%SCEN%','SLKK',VARE,'OMSV'));
