*
RESULTAT('%SCEN%',F,VARE,PRDK) $ (SUM(R$R_TIL_F(F,R), RESULTAT('%SCEN%',R,VARE,PRDK) * RESULTAT('%SCEN%',R,'OMFG',PRDK)) AND (RESULTAT('%SCEN%',F,'OMFG',PRDK) > EPS))
  = SUM(R$R_TIL_F(F,R), RESULTAT('%SCEN%',R,VARE,PRDK) * RESULTAT('%SCEN%',R,'OMFG',PRDK)) / RESULTAT('%SCEN%',F,'OMFG',PRDK);
RESULTAT('%SCEN%',F,B,ARBKAP) $ SUM(PRDK$B_TIL_HRDK(B,PRDK), RESULTAT('%SCEN%',F,'OMFG',PRDK))
  = SUM((R,PRDK)$(B_TIL_HRDK(B,PRDK) AND RESULTAT('%SCEN%',R,B,ARBKAP) AND R_TIL_F(F,R)), RESULTAT('%SCEN%',R,B,ARBKAP) * RESULTAT('%SCEN%',R,'OMFG',PRDK)) / SUM(PRDK$B_TIL_HRDK(B,PRDK), RESULTAT('%SCEN%',F,'OMFG',PRDK));
RESULTAT('%SCEN%',M,VARE,PRDK) $ (SUM(R$R_TIL_M(M,R), RESULTAT('%SCEN%',R,VARE,PRDK) * RESULTAT('%SCEN%',R,'OMFG',PRDK)) AND (RESULTAT('%SCEN%',M,'OMFG',PRDK) > EPS))
  = SUM(R$R_TIL_M(M,R), RESULTAT('%SCEN%',R,VARE,PRDK) * RESULTAT('%SCEN%',R,'OMFG',PRDK)) / RESULTAT('%SCEN%',M,'OMFG',PRDK);
RESULTAT('%SCEN%',M,B,ARBKAP) $ SUM(PRDK$B_TIL_HRDK(B,PRDK), RESULTAT('%SCEN%',M,'OMFG',PRDK))
  = SUM((R,PRDK)$(B_TIL_HRDK(B,PRDK) AND RESULTAT('%SCEN%',R,B,ARBKAP) AND R_TIL_M(M,R)), RESULTAT('%SCEN%',R,B,ARBKAP) * RESULTAT('%SCEN%',R,'OMFG',PRDK)) / SUM(PRDK$B_TIL_HRDK(B,PRDK), RESULTAT('%SCEN%',M,'OMFG',PRDK));
RESULTAT('%SCEN%','NORGE',B,ARBKAP) $ SUM(PRDK$B_TIL_HRDK(B,PRDK), RESULTAT('%SCEN%','NORGE','OMFG',PRDK))
  = SUM((R,PRDK)$(B_TIL_HRDK(B,PRDK) AND RESULTAT('%SCEN%',R,B,ARBKAP)), RESULTAT('%SCEN%',R,B,ARBKAP) * RESULTAT('%SCEN%',R,'OMFG',PRDK)) / SUM(PRDK$B_TIL_HRDK(B,PRDK), RESULTAT('%SCEN%','NORGE','OMFG',PRDK));
