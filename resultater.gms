RESULTAT('%SCEN%',F,'AREAL','VERD') = SUM(STEPRES, RESNORGE('PJBK','AREAL',F,STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%',S,'AREAL','VERD') = SUM(STEPRES, RESNORGE('PJBK','AREAL',S,STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%',DG,'AREAL','VERD') = SUM(STEPRES, RESNORGE('PJBK','AREAL',DG,STEPRES)) / CARD(STEPRES);
