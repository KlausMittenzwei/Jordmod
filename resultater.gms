************************************************************************
*
*   Jordmod-prosjekt 2005-2007
*
*   Ansvarlig: Klaus, NILF
*   Formaal: Forberede resultater og skrive ut resultater
*   Kommentarer:
*   Enheter: Priser i kr / kg, dyr, daa etc
*            Mengder i 1000 kg
*            Verdier i 1000 kr
*            Omfang i  1000 dyr eller daa
*   Status:
*
************************************************************************
$ontext
* Lese inn dette for � kj�re resultater.gms uavhengig av jordmod.gms
* Definisjon av klimatiltak
SET KLTK Klimatiltak /
         GRKL       Bedre kvalitet p� grovf�r med lav kostnad
         GRKH       Bedre kvalitet p� grovf�r med h�y kostnad
         GJSL       Spredning av husdyrgj�dsel med lav kostnad
         GJSH       Spredning av husdyrgj�dsel med h�y kostnad
         BIGL       Biogassanlegg med lav kostnad
         BIGH       Biogassanlegg med h�y kostnad
         KRFL       Klimavennlig kraftfor med lav kostnad
         KRFH       Klimavennlig kraftfor med h�y kostnad
         LAGL       Laglighet med lav kostnad
         LAGH       Laglighet med h�y kostnad
         GRFL       Gr�fting med lav kostnad
         GRFH       Gr�fting med h�y kostnad
         VSFL       Vekstskifte korn med gras og oljevekster lav kostnad
         VSFH       Vekstskifte korn med gras og oljevekster h�y kostnad
/;
* Lese inn tidligere resultater for sizedata
$include sets.gms

$setglobal SCEN BAS

* Antall iterasjoner mellom modulene
SET STEP /I1*I5/;
ALIAS(STEPSTEP,STEP);
* Velg hvilke iterasjoner som skal danne likevektsloesningen
SET STEPRES(STEP) /I4*I5/;

PARAMETER RESNORGE(*,*,*,*);

$GDXIN 'resultater\%SCEN%_RESNORGE.gdx'
$LOAD resnorge
$GDXIN
$offtext


PARAMETER RESULTAT(*,*,*,*);
**************************
* Totalkalkyle primaerjordbruk
**************************
RESULTAT('%SCEN%','PJBK',TILSKUDD,B) = SUM(STEPRES, RESNORGE('PJBK',TILSKUDD,B,STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','PJBK',VARE,'VERD') = SUM(STEPRES, RESNORGE('PJBK',VARE,'VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','PJBK',VARE,'MNGD') = SUM(STEPRES, RESNORGE('PJBK',VARE,'MNGD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','PJBK','KFOR','VERD') = SUM(STEPRES, RESNORGE('PJBK','KFOR','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','PJBK',VARE,'PRIS') $ (RESULTAT('%SCEN%','PJBK',VARE,'MNGD') > EPS) = RESULTAT('%SCEN%','PJBK',VARE,'VERD') / RESULTAT('%SCEN%','PJBK',VARE,'MNGD') ;
RESULTAT('%SCEN%','PJBK','MIAV','VERD') = SUM(STEPRES, RESNORGE('PJBK','MIAV','VERD',STEPRES)) / CARD(STEPRES);
*RESULTAT('%SCEN%','PJBK','PROF','VERD') = SUM(PRODUKT, RESULTAT('%SCEN%','PJBK',PRODUKT,'VERD'))
*                               + SUM(TILSKUDD, RESULTAT('%SCEN%','PJBK',TILSKUDD,'VERD'))
*                               - SUM(INNSATS, RESULTAT('%SCEN%','PJBK',INNSATS,'VERD'))
*                               - RESULTAT('%SCEN%','PJBK','MIAV','VERD');
*
RESULTAT('%SCEN%','PJBK','MINT','VERD') = SUM(STEPRES, RESNORGE('PJBK','MINT','VERD',STEPRES)) / CARD (STEPRES) ;
RESULTAT('%SCEN%','PJBK','KOST','VERD') = SUM(STEPRES, RESNORGE('PJBK','KOST','VERD',STEPRES)) / CARD (STEPRES) ;
RESULTAT('%SCEN%','PJBK','TIL','VERD')  = SUM(STEPRES, RESNORGE('PJBK','TIL','VERD',STEPRES)) / CARD (STEPRES) ;
RESULTAT('%SCEN%','PJBK','KSTF','VERD') = SUM(STEPRES, RESNORGE('PJBK','KSTF','VERD',STEPRES)) / CARD (STEPRES) ;
RESULTAT('%SCEN%','PJBK','AVKF','VERD') = SUM(STEPRES, RESNORGE('PJBK','AVKF','VERD',STEPRES)) / CARD (STEPRES) ;
RESULTAT('%SCEN%','PJBK','AVNI','VERD') = SUM(STEPRES, RESNORGE('PJBK','AVNI','VERD',STEPRES)) / CARD (STEPRES) ;
RESULTAT('%SCEN%','PJBK','PMP','VERD')  = SUM(STEPRES, RESNORGE('PJBK','PMP','VERD',STEPRES )) / CARD (STEPRES) ;
RESULTAT('%SCEN%','PJBK','GHGD','VERD') = SUM(STEPRES, RESNORGE('PJBK','GHGD','VERD',STEPRES))   / CARD (STEPRES) ;
RESULTAT('%SCEN%','PJBK','PROF','VERD') = SUM(STEPRES, RESNORGE('PJBK','PROF','VERD',STEPRES)) / CARD (STEPRES) ;
                                    
RESULTAT('%SCEN%','PJBK',VARE,'MINT')   = SUM(STEPRES, RESNORGE('PJBK',VARE,'MINT',STEPRES)) / CARD(STEPRES)   ;
RESULTAT('%SCEN%','VERD',VARE,'NORGE')   = SUM(STEPRES, RESNORGE('VERD',VARE,'NORGE',STEPRES)) / CARD(STEPRES)   ;
RESULTAT('%SCEN%','VERD','KORN','NORGE') = SUM(STEPRES, RESNORGE('VERD','KORN','NORGE',STEPRES) / CARD(STEPRES)) ;
RESULTAT('%SCEN%',R,B,'AKS%') = SUM(STEPRES, RESNORGE(R,B,'AKS%',STEPRES) / CARD(STEPRES)) ;
*
**************************
* Totalkalkyle meierier
**************************

RESULTAT('%SCEN%','MEIK','MINT','VERD') = SUM(STEPRES,  RESNORGE('MEIK','MINT','VERD',STEPRES)) / CARD(STEPRES); 
RESULTAT('%SCEN%','MEIK','XINT','VERD') = SUM(STEPRES,  RESNORGE('MEIK','XINT','VERD',STEPRES)) / CARD(STEPRES); 
RESULTAT('%SCEN%','MEIK','IUTG','VERD') = SUM(STEPRES,  RESNORGE('MEIK','IUTG','VERD',STEPRES)) / CARD(STEPRES); 
RESULTAT('%SCEN%','MEIK','IUTQ','VERD') = SUM(STEPRES,  RESNORGE('MEIK','IUTQ','VERD',STEPRES)) / CARD(STEPRES); 
RESULTAT('%SCEN%','MEIK','XTIL','VERD') = SUM(STEPRES,  RESNORGE('MEIK','XTIL','VERD',STEPRES)) / CARD(STEPRES); 
RESULTAT('%SCEN%','MEIK','TRTL','VERD') = SUM(STEPRES,  RESNORGE('MEIK','TRTL','VERD',STEPRES)) / CARD(STEPRES); 
RESULTAT('%SCEN%','MEIK','NTPU','VERD') = SUM(STEPRES,  RESNORGE('MEIK','NTPU','VERD',STEPRES)) / CARD(STEPRES); 
RESULTAT('%SCEN%','MEIK','IUMK','VERD') = SUM(STEPRES,  RESNORGE('MEIK','IUMK','VERD',STEPRES)) / CARD(STEPRES); 
RESULTAT('%SCEN%','MEIK','OMST','VERD') = SUM(STEPRES,  RESNORGE('MEIK','OMST','VERD',STEPRES)) / CARD(STEPRES); 
RESULTAT('%SCEN%','MEIK','PROC','VERD') = SUM(STEPRES,  RESNORGE('MEIK','PROC','VERD',STEPRES)) / CARD(STEPRES); 
RESULTAT('%SCEN%','MEIK','GHGI','VERD') = SUM(STEPRES,  RESNORGE('MEIK','GHGI','VERD',STEPRES))  / CARD(STEPRES); 
RESULTAT('%SCEN%','MEIK','TRSP','VERD') = SUM(STEPRES,  RESNORGE('MEIK','TRSP','VERD',STEPRES)) / CARD(STEPRES); 
RESULTAT('%SCEN%','MEIK','RAAV','VERD') = SUM(STEPRES,  RESNORGE('MEIK','RAAV','VERD',STEPRES)) / CARD(STEPRES); 
RESULTAT('%SCEN%','MEIK','MAIM','VERD') = SUM(STEPRES,  RESNORGE('MEIK','MAIM','VERD',STEPRES)) / CARD(STEPRES); 
RESULTAT('%SCEN%','MEIK','MARG','VERD') = SUM(STEPRES,  RESNORGE('MEIK','MARG','VERD',STEPRES)) / CARD(STEPRES); 
RESULTAT('%SCEN%','MEIK','PROF','VERD') = SUM(STEPRES,  RESNORGE('MEIK','PROF','VERD',STEPRES)) / CARD(STEPRES); 
RESULTAT('%SCEN%','MEIK','NORM','MNGD') = SUM(STEPRES,  RESNORGE('MEIK','NORM','MNGD',STEPRES)) / CARD(STEPRES); 
RESULTAT('%SCEN%','MEIK','EKSP','MNGD') = SUM(STEPRES,  RESNORGE('MEIK','EKSP','MNGD',STEPRES)) / CARD(STEPRES); 
RESULTAT('%SCEN%','MEIK',MEIR,'NTPU')   = SUM(STEPRES, RESNORGE('MEIK',MEIR,'NTPU',STEPRES))    / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',VARE,'UTJV')   = SUM(STEPRES, RESNORGE('MEIK',VARE,'UTJV',STEPRES))    / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',VARE,'OMST')   = SUM(STEPRES, RESNORGE('MEIK',VARE,'OMST',STEPRES))    / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',MEIR,'PROC')   = SUM(STEPRES, RESNORGE('MEIK',MEIR,'PROC',STEPRES))    / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',VARE,'TRSP')   = SUM(STEPRES, RESNORGE('MEIK',VARE,'TRSP',STEPRES))    / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',VARE,'RAAV')   = SUM(STEPRES, RESNORGE('MEIK',VARE,'RAAV',STEPRES))    / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',VARE,'MAIM')   = SUM(STEPRES, RESNORGE('MEIK',VARE,'MAIM',STEPRES))    / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',VARE,'MARG')   = SUM(STEPRES, RESNORGE('MEIK',VARE,'MARG',STEPRES))    / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',VARE,'MNGD_MOD') = SUM(STEPRES, RESNORGE('MEIK',VARE,'MNGD_MOD',STEPRES)) / CARD(STEPRES); 
RESULTAT('%SCEN%','MEIK',VARE,'MNGD_OBS') = SUM(STEPRES, RESNORGE('MEIK',VARE,'MNGD_OBS',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',VARE,'MNGD_IMP') = SUM(STEPRES, RESNORGE('MEIK',VARE,'MNGD_IMP',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',VARE,'IUTG')   = SUM(STEPRES, RESNORGE('MEIK',VARE,'IUTG',STEPRES))   / CARD(STEPRES);   
RESULTAT('%SCEN%','MEIK',VARE,'IUTQ')   = SUM(STEPRES, RESNORGE('MEIK',VARE,'IUTQ',STEPRES))   / CARD(STEPRES);   
*
RESULTAT('%SCEN%','MEIK',VARE,'TRTL') = SUM(STEPRES,  RESNORGE('MEIK',VARE,'TRTL',STEPRES)) / CARD(STEPRES); 

$ontext
RESULTAT('%SCEN%','MEIK',VARE,'INTV') = SUM(STEPRES, RESNORGE('MEIK',VARE,'INTV',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',VARE,'INTM') = SUM(STEPRES, RESNORGE('MEIK',VARE,'INTM',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',VARE,'INTP') $ RESULTAT('%SCEN%','MEIK',VARE,'INTM') = RESULTAT('%SCEN%','MEIK',VARE,'INTV') / RESULTAT('%SCEN%','MEIK',VARE,'INTM');
RESULTAT('%SCEN%','MEIK','VARE','INTV') = SUM(VARE, RESULTAT('%SCEN%','MEIK',VARE,'INTV'));
RESULTAT('%SCEN%','MEIK','VARE','IMPV') = SUM(VARE$MEIDVARE(VARE), RESULTAT('%SCEN%','MEIK',VARE,'INTV'));
RESULTAT('%SCEN%','MEIK',VARE,'EKSV') = SUM(STEPRES, RESNORGE('MEIK',VARE,'EKSV',STEPRES))/ CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',VARE,'EKSM') = SUM(STEPRES, RESNORGE('MEIK',VARE,'EKSM',STEPRES))/ CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',VARE,'EKSP') $ RESULTAT('%SCEN%','MEIK',VARE,'EKSM') = RESULTAT('%SCEN%','MEIK',VARE,'EKSV') / RESULTAT('%SCEN%','MEIK',VARE,'EKSM');
RESULTAT('%SCEN%','MEIK','VARE','EKSV') = SUM(VARE, RESULTAT('%SCEN%','MEIK',VARE,'EKSV'));
RESULTAT('%SCEN%','MEIK','VARE','EKSM') = SUM(VARE, RESULTAT('%SCEN%','MEIK',VARE,'EKSM'));
RESULTAT('%SCEN%','MEIK','VARE','EKSP') $ RESULTAT('%SCEN%','MEIK','VARE','EKSM') = RESULTAT('%SCEN%','MEIK','VARE','EKSV') / RESULTAT('%SCEN%','MEIK','VARE','EKSM');
RESULTAT('%SCEN%','MEIK','XTIL','VERD') = SUM(STEPRES, RESNORGE('MEIK','XTIL','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK','NTPU','VERD') = SUM(STEPRES, RESNORGE('MEIK','NTPU','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK','INNT','VERD') = RESULTAT('%SCEN%','MEIK','VARE','INTV') + RESULTAT('%SCEN%','MEIK','VARE','EKSV') + RESULTAT('%SCEN%','MEIK','XTIL','VERD');
RESULTAT('%SCEN%','MEIK','OMST','VERD') = SUM(STEPRES, RESNORGE('MEIK','OMST','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK','UTJV','VERD') = SUM(STEPRES, RESNORGE('MEIK','UTJV','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK','OMST','MNGD') = SUM((STEPRES,MEIINNVARE), RESNORGE('PROD',MEIINNVARE,'MNGD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK','OMST','PRIS') $ RESULTAT('%SCEN%','MEIK','OMST','MNGD') = RESULTAT('%SCEN%','MEIK','OMST','VERD') / RESULTAT('%SCEN%','MEIK','OMST','MNGD');
RESULTAT('%SCEN%','MEIK','TINE','VERD') = SUM(STEPRES, RESNORGE('MEIK','TINE','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK','TINE','MNGD') = SUM((STEPRES,MEIINNVARE), RESNORGE('PROD',MEIINNVARE,'MNGD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK','TINE','PRIS') $ RESULTAT('%SCEN%','MEIK','TINE','MNGD') = RESULTAT('%SCEN%','MEIK','TINE','VERD') / RESULTAT('%SCEN%','MEIK','TINE','MNGD');
RESULTAT('%SCEN%','MEIK',MEIR,'VERD') = SUM(STEPRES, RESNORGE('MEIK',MEIR,'VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',MEIR,'MNGD') = SUM((M,STEPRES), RESNORGE(M,MEIR,'MNGD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',MEIR,'PRIS') $ RESULTAT('%SCEN%','MEIK',MEIR,'MNGD') = RESULTAT('%SCEN%','MEIK',MEIR,'VERD') / RESULTAT('%SCEN%','MEIK',MEIR,'MNGD');
RESULTAT('%SCEN%','MEIK','MEIR','VERD') = SUM(MEIR, RESULTAT('%SCEN%','MEIK',MEIR,'VERD'));
RESULTAT('%SCEN%','MEIK','MEIR','MNGD') = SUM(MEIR, RESULTAT('%SCEN%','MEIK',MEIR,'MNGD'));
RESULTAT('%SCEN%','MEIK','MEIR','PRIS') $ RESULTAT('%SCEN%','MEIK','MEIR','MNGD') = RESULTAT('%SCEN%','MEIK','MEIR','VERD') / RESULTAT('%SCEN%','MEIK','MEIR','MNGD');
RESULTAT('%SCEN%','MEIK',MEIR,'AKSV') = SUM(STEPRES, RESNORGE('MEIK',MEIR,'AKST',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',MEIR,'AKSM') = RESULTAT('%SCEN%','MEIK',MEIR,'MNGD');
RESULTAT('%SCEN%','MEIK',MEIR,'AKSP') $ RESULTAT('%SCEN%','MEIK',MEIR,'AKSM') = RESULTAT('%SCEN%','MEIK',MEIR,'AKSV') / RESULTAT('%SCEN%','MEIK',MEIR,'AKSM');
RESULTAT('%SCEN%','MEIK','MEIR','AKSV') = SUM(MEIR, RESULTAT('%SCEN%','MEIK',MEIR,'AKSV'));
RESULTAT('%SCEN%','MEIK','MEIR','AKSM') = SUM(MEIR, RESULTAT('%SCEN%','MEIK',MEIR,'AKSM'));
RESULTAT('%SCEN%','MEIK','MEIR','AKSP') $ RESULTAT('%SCEN%','MEIK','MEIR','AKSM') = RESULTAT('%SCEN%','MEIK','MEIR','AKSV') / RESULTAT('%SCEN%','MEIK','MEIR','AKSM');
RESULTAT('%SCEN%','MEIK','MEIR','IKSV') = SUM((STEPRES,MEIR), RESNORGE('MEIK',MEIR,'IKST',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK','MEIR','IKSM') = SUM((STEPRES,MEIINNVARE), RESNORGE('PROD',MEIINNVARE,'MNGD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK','MEIR','IKSP') $ RESULTAT('%SCEN%','MEIK','MEIR','IKSM') = RESULTAT('%SCEN%','MEIK','MEIR','IKSV') / RESULTAT('%SCEN%','MEIK','MEIR','IKSM');
RESULTAT('%SCEN%','MEIK','VARE','IKSV') = SUM(VARE, RESULTAT('%SCEN%','MEIK',VARE,'IKSV'));
RESULTAT('%SCEN%','MEIK','VARE','IKSM') = SUM(VARE, RESULTAT('%SCEN%','MEIK',VARE,'IKSM'));
RESULTAT('%SCEN%','MEIK','VARE','IKSP') $ RESULTAT('%SCEN%','MEIK','VARE','IKSM') = RESULTAT('%SCEN%','MEIK','VARE','IKSV') / RESULTAT('%SCEN%','MEIK','VARE','IKSM');
RESULTAT('%SCEN%','MEIK','TRSP','VERD') = SUM(STEPRES, RESNORGE('MEIK','TRSP','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',VARE,'RAAV') $ MEIINNVARE(VARE) = SUM(STEPRES, RESNORGE('MEIK',VARE,'RAAV',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',VARE,'RAAM') $ MEIINNVARE(VARE) = SUM(STEPRES, RESNORGE('PROD',VARE,'MNGD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',VARE,'RAAP') $ RESULTAT('%SCEN%','MEIK',VARE,'RAAM') = RESULTAT('%SCEN%','MEIK',VARE,'RAAV') / RESULTAT('%SCEN%','MEIK',VARE,'RAAM');
RESULTAT('%SCEN%','MEIK','VARE','RAAV') = SUM(VARE, RESULTAT('%SCEN%','MEIK',VARE,'RAAV'));
RESULTAT('%SCEN%','MEIK','VARE','RAAM') = SUM(VARE, RESULTAT('%SCEN%','MEIK',VARE,'RAAM'));
RESULTAT('%SCEN%','MEIK','VARE','RAAP') $ RESULTAT('%SCEN%','MEIK','VARE','RAAM') = RESULTAT('%SCEN%','MEIK','VARE','RAAV') / RESULTAT('%SCEN%','MEIK','VARE','RAAM');
RESULTAT('%SCEN%','MEIK',VARE,'IOPV') = SUM(STEPRES, RESNORGE('MEIK',VARE,'IUTG',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',VARE,'IQPV') = SUM(STEPRES, RESNORGE('MEIK',VARE,'IUTQ',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK','VARE','IOPV') = SUM(VARE, RESULTAT('%SCEN%','MEIK',VARE,'IOPV'));
RESULTAT('%SCEN%','MEIK','VARE','IQPV') = SUM(VARE, RESULTAT('%SCEN%','MEIK',VARE,'IQPV'));
RESULTAT('%SCEN%','MEIK',VARE,'IMPV') = RESULTAT('%SCEN%','MEIK',VARE,'IOPV') + RESULTAT('%SCEN%','MEIK',VARE,'IQPV') ;
RESULTAT('%SCEN%','MEIK','VARE','IMPV') = RESULTAT('%SCEN%','MEIK','VARE','IOPV') + RESULTAT('%SCEN%','MEIK','VARE','IQPV') ;
RESULTAT('%SCEN%','MEIK',VARE,'IMPM') $ MEIVARE(VARE) = SUM(STEPRES, RESNORGE('IMPO',VARE,'MNGD',STEPRES)) / CARD(STEPRES)
                                             + SUM(STEPRES, RESNORGE('IMPQ',VARE,'MNGD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',VARE,'IMPP') $ RESULTAT('%SCEN%','MEIK',VARE,'IMPM') = RESULTAT('%SCEN%','MEIK',VARE,'IMPV') / RESULTAT('%SCEN%','MEIK',VARE,'IMPM');
RESULTAT('%SCEN%','MEIK','VARE','IMPV') = SUM(VARE, RESULTAT('%SCEN%','MEIK',VARE,'IMPV'));
RESULTAT('%SCEN%','MEIK','VARE','IMPM') = SUM(VARE, RESULTAT('%SCEN%','MEIK',VARE,'IMPM'));
RESULTAT('%SCEN%','MEIK','VARE','IMPP') $ RESULTAT('%SCEN%','MEIK','VARE','IMPM') = RESULTAT('%SCEN%','MEIK','VARE','IMPV') / RESULTAT('%SCEN%','MEIK','VARE','IMPM');
RESULTAT('%SCEN%','MEIK','MAIM','VERD') = SUM(STEPRES, RESNORGE('MEIK','MAIM','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK',VARE,'MARG')   = SUM(STEPRES, RESNORGE('MEIK',VARE,'MARG',STEPRES))   / CARD(STEPRES);
RESULTAT('%SCEN%','MEIK','PROF','VERD') = SUM(STEPRES, RESNORGE('MEIK','PROF','VERD',STEPRES)) / CARD(STEPRES);
$offtext
