RESULTAT('%SCEN%',M,'MEIR','OMFG') = SUM(STEPRES, RESNORGE(M,'MEIR','OMFG',STEPRES))/ CARD(STEPRES);
RESULTAT('%SCEN%',M,'MEIR','STOR') $ RESULTAT('%SCEN%',M,'MEIR','OMFG') = SUM(STEPRES, RESNORGE(M,'MEIR','STOR',STEPRES)) / CARD(STEPRES) / RESULTAT('%SCEN%',M,'MEIR','OMFG');
RESULTAT('%SCEN%','NORGE','MEIR','STOR') = SUM(M$RESULTAT('%SCEN%',M,'MEIR','OMFG'), RESULTAT('%SCEN%',M,'MEIR','STOR') * RESULTAT('%SCEN%',M,'MEIR','OMFG')) /
                                  SUM(M$RESULTAT('%SCEN%',M,'MEIR','OMFG'), RESULTAT('%SCEN%',M,'MEIR','OMFG'));
RESULTAT('%SCEN%',M,MEIR,'MNGD')   = SUM(STEPRES, RESNORGE(M,MEIR,'MNGD',STEPRES))  / CARD(STEPRES) / RESULTAT('%SCEN%',M,'MEIR','OMFG');
RESULTAT('%SCEN%','NORGE',MEIR,'MNGD') = SUM(M, RESULTAT('%SCEN%',M,MEIR,'MNGD') * RESULTAT('%SCEN%',M,'MEIR','OMFG')) / SUM(M, RESULTAT('%SCEN%',M,'MEIR','OMFG'));
RESULTAT('%SCEN%',M,'MELK','BOND') = SUM(STEPRES, RESNORGE(M,'MELK','BOND',STEPRES))/ CARD(STEPRES);
RESULTAT('%SCEN%','NORGE','GARD','MEI') = SUM(STEPRES, RESNORGE('%SCEN%','NORGE','GARD','MEI')) / CARD(STEPRES);
