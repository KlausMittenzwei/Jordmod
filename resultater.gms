RESULTAT('%SCEN%','SLKK','RAAV','VERD')    = SUM(STEPRES, RESNORGE('SLKK','RAAV','VERD',STEPRES))   / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK','MAIM','VERD')    = SUM(STEPRES, RESNORGE('SLKK','MAIM','VERD',STEPRES))   / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK','MARG','VERD')    = SUM(STEPRES, RESNORGE('SLKK','MARG','VERD',STEPRES))   / CARD(STEPRES);
