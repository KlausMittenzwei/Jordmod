RESULTAT('%SCEN%','MOELL','IUTQ','VERD') = SUM(STEPRES, RESNORGE('MOEL','IUTQ','VERD',STEPRES)) / CARD(STEPRES);
*RESULTAT('%SCEN%','MOELL','VARE','EKSV') = SUM(STEPRES, RESNORGE('MOEL','XINN','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MOELL','VARE','INTV') = SUM(STEPRES, RESNORGE('MOEL','SMEL','VERD',STEPRES)) / CARD(STEPRES)
                                + SUM(STEPRES, RESNORGE('MOEL','SFOR','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MOELL','VARE','KFOR') = SUM(STEPRES, RESNORGE('MOEL','SFOR','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MOELL','VARE','FRDL') = SUM(STEPRES, RESNORGE('MOEL','KOST','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MOELL','VARE','RAAV') = SUM(STEPRES, RESNORGE('MOEL','RAAV','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MOELL','VARE','TRSP') = SUM(STEPRES, RESNORGE('MOEL','TRSP','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MOELL','MAIM','VERD') = SUM(STEPRES, RESNORGE('MOEL','MAIM','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MOELL','FTIL','VERD') = SUM(STEPRES, RESNORGE('MOEL','FTIL','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MOELL','PTIL','VERD') = SUM(STEPRES, RESNORGE('MOEL','PTIL','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MOELL','VARE','KOST') = RESULTAT('%SCEN%','MOELL','IUTG','VERD') + RESULTAT('%SCEN%','MOELL','IUTQ','VERD')
                                + RESULTAT('%SCEN%','MOELL','VARE','RAAV') + RESULTAT('%SCEN%','MOELL','VARE','TRSP')
                                + RESULTAT('%SCEN%','MOELL','VARE','FRDL') + RESULTAT('%SCEN%','MOELL','MAIM','VERD');
RESULTAT('%SCEN%','MOELL','VARE','INNT') =  RESULTAT('%SCEN%','MOELL','VARE','INTV') + RESULTAT('%SCEN%','MOELL','VARE','EKSV');
RESULTAT('%SCEN%','MOELL','VARE','PROF') =  RESULTAT('%SCEN%','MOELL','VARE','INNT') - RESULTAT('%SCEN%','MOELL','VARE','KOST') + RESULTAT('%SCEN%','MOELL','VARE','FTIL');
RESULTAT('%SCEN%','MOELL','KOST','PRIS') = SUM(STEPRES, RESNORGE('MOEL','KOST','PRIS',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MOELL',MOELUTVARE,'MNGD') = SUM(STEPRES, RESNORGE('MOEL',MOELUTVARE,'MNGD',STEPRES)) / CARD(STEPRES);
