RESULTAT('%SCEN%','SLKK',VARE,'MNGD_MOD')  = SUM(STEPRES, RESNORGE('SLKK',VARE,'MNGD_MOD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK',VARE,'MNGD_OBS')  = SUM(STEPRES, RESNORGE('SLKK',VARE,'MNGD_OBS',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK',VARE,'MNGD_IMP')  = SUM(STEPRES, RESNORGE('SLKK',VARE,'MNGD_IMP',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK',VARE,'VERD')      = SUM(STEPRES, RESNORGE('SLKK',VARE,'VERD',STEPRES))     / CARD(STEPRES);
