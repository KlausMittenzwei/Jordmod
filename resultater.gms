RESULTAT('%SCEN%',R,B,'ANTL') =  SUM(STEPRES, RESNORGE(R,B,'ANTL',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%',R,B,'STOR') =  SUM(STEPRES, RESNORGE(R,B,'STOR',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%',R,B,'BRUK') =  SUM(STEPRES, RESNORGE(R,B,'BRUK',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%',F,B,'STOR')  $ SUM(R$R_TIL_F(F,R),   RESULTAT('%SCEN%',R,B,'BRUK')) =  SUM(R$R_TIL_F(F,R),   RESULTAT('%SCEN%',R,B,'STOR') * RESULTAT('%SCEN%',R,B,'BRUK')) / SUM(R$R_TIL_F(F,R),   RESULTAT('%SCEN%',R,B,'BRUK'));
RESULTAT('%SCEN%',DG,B,'STOR') $ SUM(R$R_TIL_DG(DG,R), RESULTAT('%SCEN%',R,B,'BRUK')) =  SUM(R$R_TIL_DG(DG,R), RESULTAT('%SCEN%',R,B,'STOR') * RESULTAT('%SCEN%',R,B,'BRUK')) / SUM(R$R_TIL_DG(DG,R), RESULTAT('%SCEN%',R,B,'BRUK'));
RESULTAT('%SCEN%',SD,B,'STOR') $ SUM(R$R_TIL_SD(SD,R), RESULTAT('%SCEN%',R,B,'BRUK')) =  SUM(R$R_TIL_SD(SD,R), RESULTAT('%SCEN%',R,B,'STOR') * RESULTAT('%SCEN%',R,B,'BRUK')) / SUM(R$R_TIL_SD(SD,R), RESULTAT('%SCEN%',R,B,'BRUK'));
RESULTAT('%SCEN%',M,B,'STOR')  $ SUM(R$R_TIL_M(M,R),   RESULTAT('%SCEN%',R,B,'BRUK')) =  SUM(R$R_TIL_M(M,R),   RESULTAT('%SCEN%',R,B,'STOR') * RESULTAT('%SCEN%',R,B,'BRUK')) / SUM(R$R_TIL_M(M,R),   RESULTAT('%SCEN%',R,B,'BRUK'));
RESULTAT('%SCEN%','NORGE',B,'STOR') $ SUM(R, RESULTAT('%SCEN%',R,B,'BRUK')) =  SUM(R, RESULTAT('%SCEN%',R,B,'STOR') * RESULTAT('%SCEN%',R,B,'BRUK')) / SUM(R, RESULTAT('%SCEN%',R,B,'BRUK'));
RESULTAT('%SCEN%','NORGE',B,'ANTL') =  SUM(STEPRES, RESNORGE('NORGE',B,'ANTL',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%',M,B,'BRUK')  =  SUM(R$R_TIL_M(M,R),   RESULTAT('%SCEN%',R,B,'BRUK'));
RESULTAT('%SCEN%','NORGE',B,'BRUK') =  SUM(R, RESULTAT('%SCEN%',R,B,'BRUK'));
RESULTAT('%SCEN%',F,'TILSKUDD','VERD') = SUM(STEPRES, RESNORGE('PJBK','TILSKUDD',F,STEPRES)) / CARD(STEPRES);
