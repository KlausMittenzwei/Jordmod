RESULTAT('%SCEN%','AIND','VARE','RAAV')  = SUM(STEPRES, RESNORGE('AIND','RAAV','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','AIND','VARE','FRDL')  = SUM(STEPRES, RESNORGE('AIND','KOST','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','AIND','VARE','TRSP')  = SUM(STEPRES, RESNORGE('AIND','TRSP','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','AIND','VARE','KOST') = RESULTAT('%SCEN%','AIND','IUTG','VERD') + RESULTAT('%SCEN%','AIND','IUTQ','VERD')
                                + RESULTAT('%SCEN%','AIND','VARE','RAAV') + RESULTAT('%SCEN%','AIND','VARE','TRSP')
                                + RESULTAT('%SCEN%','AIND','VARE','FRDL');
RESULTAT('%SCEN%','AIND','VARE','INNT') =  RESULTAT('%SCEN%','AIND','VARE','INTV') + RESULTAT('%SCEN%','AIND','VARE','EKSV');
RESULTAT('%SCEN%','AIND','VARE','PROF') =  RESULTAT('%SCEN%','AIND','VARE','INNT') - RESULTAT('%SCEN%','AIND','VARE','KOST');
RESULTAT('%SCEN%','NORGE','KSLK','PRIS') = SUM(STEPRES, RESNORGE('NORGE','KSLK','PRIS',STEPRES)) / CARD(STEPRES);
$offtext
*
**************************
* Totalkalkyle hele sektor
**************************
RESULTAT('%SCEN%','TOTK','MINN','VERD') = SUM(STEPRES, RESNORGE('TOTK','SINN','VERD',STEPRES)) / CARD(STEPRES)
                               + RESULTAT('%SCEN%','MOEL','VARE','KFOR') + SUM(PRODUKT, RESULTAT('%SCEN%','PJBK',PRODUKT,'VERD'));
RESULTAT('%SCEN%','TOTK','XINN','VERD') = SUM(STEPRES, RESNORGE('TOTK','XINN','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','TOTK','NTUJ','VERD') = RESULTAT('%SCEN%','MEIK','NTPU','VERD') + RESULTAT('%SCEN%','SLKK','NTIU','VERD');
RESULTAT('%SCEN%','TOTK','INNT','VERD') = RESULTAT('%SCEN%','TOTK','MINN','VERD') + RESULTAT('%SCEN%','TOTK','XINN','VERD');
RESULTAT('%SCEN%','TOTK','IORD','VERD') = SUM(STEPRES, RESNORGE('TOTK','IORD','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','TOTK','IKVT','VERD') = SUM(STEPRES, RESNORGE('TOTK','IKVT','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','TOTK','KOST','VERD') = SUM(STEPRES, RESNORGE('TOTK','KOST','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','TOTK','BKST','VERD') = SUM(STEPRES, RESNORGE('TOTK','BKST','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','TOTK','KSTG','VERD') = SUM(STEPRES, RESNORGE('TOTK','KSTG','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','TOTK','RAAV','VERD') = RESULTAT('%SCEN%','MEIK','VARE','RAAV') + RESULTAT('%SCEN%','SLKK','VARE','RAAV')
                               + RESULTAT('%SCEN%','MOEL','VARE','RAAV') + RESULTAT('%SCEN%','AIND','VARE','RAAV');
RESULTAT('%SCEN%','TOTK','SLK','VERD')  = SUM(STEPRES, RESNORGE('TOTK','SLK','VERD',STEPRES))  / CARD(STEPRES);
RESULTAT('%SCEN%','TOTK','MEIR','VERD') = SUM(STEPRES, RESNORGE('TOTK','MEIR','VERD',STEPRES)) / CARD(STEPRES)
                               + SUM(STEPRES, RESNORGE('TOTK','OMST','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','TOTK','MOEL','VERD') = SUM(STEPRES, RESNORGE('TOTK','MOEL','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','TOTK','AIND','VERD') = SUM(STEPRES, RESNORGE('TOTK','AIND','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','TOTK','FRDL','VERD') = RESULTAT('%SCEN%','MEIK','FRDL','VERD') + RESULTAT('%SCEN%','SLKK','FRDL','VERD')
                               + RESULTAT('%SCEN%','MOEL','VARE','FRDL') + RESULTAT('%SCEN%','AIND','VARE','FRDL');
RESULTAT('%SCEN%','TOTK','TRSP','VERD') = SUM(STEPRES, RESNORGE('TOTK','TRSP','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','TOTK','MIAV','VERD') = SUM(STEPRES, RESNORGE('TOTK','MIAV','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','TOTK','KFAV','VERD') = SUM(STEPRES, RESNORGE('TOTK','KFAV','VERD',STEPRES)) / CARD(STEPRES);

RESULTAT('%SCEN%','TOTK',MOELUTKVARE,'AVG-VERD') = SUM(STEPRES, RESNORGE('TOTK',MOELUTKVARE,'AVG-VERD',STEPRES)) / CARD(STEPRES) ;
RESULTAT('%SCEN%','TOTK',MOELUTKVARE,'AVG-MNGD') = SUM(STEPRES, RESNORGE('TOTK',MOELUTKVARE,'AVG-MNGD',STEPRES)) / CARD(STEPRES) ;
RESULTAT('%SCEN%','TOTK','TFRK','VERD') = SUM(STEPRES, RESNORGE('TOTK','TFRK','VERD',STEPRES)) / CARD(STEPRES) ;
RESULTAT('%SCEN%','TOTK','TPNS','VERD') = SUM(STEPRES, RESNORGE('TOTK','TPNS','VERD',STEPRES)) / CARD(STEPRES) ;
RESULTAT('%SCEN%','TOTK',moelutkvare,'AVG-PRIS') = SUM(STEPRES, RESNORGE('TOTK',moelutkvare,'AVG-PRIS',STEPRES)) / CARD(STEPRES) ;

RESULTAT('%SCEN%','TOTK','TKST','VERD') = RESULTAT('%SCEN%','TOTK','BKST','VERD') + RESULTAT('%SCEN%','TOTK','IORD','VERD')
                               + RESULTAT('%SCEN%','TOTK','IKVT','VERD') + RESULTAT('%SCEN%','TOTK','RAAV','VERD')
                               + RESULTAT('%SCEN%','TOTK','FRDL','VERD') + RESULTAT('%SCEN%','TOTK','TRSP','VERD')
                               + RESULTAT('%SCEN%','TOTK','MIAV','VERD');
RESULTAT('%SCEN%','TOTK','STIL','VERD') = SUM(STEPRES, RESNORGE('TOTK','TTIL','VERD',STEPRES)) / CARD(STEPRES)
                               + SUM(STEPRES, RESNORGE('TOTK','XTIL','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','TOTK','PROF','VERD') = RESULTAT('%SCEN%','TOTK','INNT','VERD') + RESULTAT('%SCEN%','TOTK','NTUJ','VERD')
                               + RESULTAT('%SCEN%','TOTK','STIL','VERD') - RESULTAT('%SCEN%','TOTK','TKST','VERD');
RESULTAT('%SCEN%','TOTK','TKOST','VERD') = SUM(STEPRES, RESNORGE('TOTK','TKOST','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','TOTK','KOSTH','VERD') = SUM(STEPRES, RESNORGE('TOTK','KOSTH','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','TOTK','TBRK','VERD') = SUM(STEPRES, RESNORGE('TOTK','TBRK','VERD',STEPRES)) / CARD(STEPRES);


