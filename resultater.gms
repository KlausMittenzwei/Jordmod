*******************************
RESULTAT('%SCEN%','PRIP',VARE,STEP) $ (PRODUKT(VARE) AND SIMVARE(VARE)) = RESNORGE('PRIP',VARE,'VERD',STEP);
RESULTAT('%SCEN%',R,'JORD',STEP)   = RESNORGE(R,'JORD','AVRD',STEP);
RESULTAT('%SCEN%',R,'FULJ',STEP)   = RESNORGE(R,'FULJ','AVRD',STEP);
RESULTAT('%SCEN%',R,'MKVT',STEP)   = RESNORGE(R,'MKVT','VERD',STEP);
RESULTAT('%SCEN%',R,'GRAS',STEP)   = RESNORGE(R,'GRAS','VERD',STEP);
RESULTAT('%SCEN%',R,B,'PROF') = SUM(STEPRES, RESNORGE(R,B,'PROF',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%',R,B,'MDST') = SUM(STEPRES, RESNORGE(R,B,'MDST',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK',SSLK,M)  =  SUM(STEPRES, RESNORGE('SLKK',SSLK,M,STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK','SSLK',M)=  SUM(STEPRES, RESNORGE('SLKK','SSLK',M,STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK','PRIN',M) = SUM(STEPRES, RESNORGE('SLKK','PRIN',M,STEPRES)) / CARD(STEPRES);
*******************************
* Skyggepriser balancing
*******************************
RESULTAT('%SCEN%','MC','AREA','NORGE') = SUM(STEPRES, RESNORGE('MC','AREA','NORGE',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MC','AREA',M)       = SUM(STEPRES, RESNORGE('MC','AREA',M,STEPRES)) / CARD(STEPRES) ;
RESULTAT('%SCEN%','MC','KORN','NORGE') = SUM(STEPRES, RESNORGE('MC','KORN','NORGE',STEPRES));
RESULTAT('%SCEN%','MC','KORN',M)       = SUM(STEPRES, RESNORGE('MC','KORN',M,STEPRES)) / CARD(STEPRES) ;
RESULTAT('%SCEN%','MC',PRDK,'NORGE')   = SUM(STEPRES, RESNORGE('MC',PRDK,'NORGE',STEPRES)) ;
RESULTAT('%SCEN%','MC',PRDK,M)         = SUM(STEPRES, RESNORGE('MC',PRDK,M,STEPRES)) ;
RESULTAT('%SCEN%','MC','ARBF','NORGE') = SUM(STEPRES, RESNORGE('MC','ARBF','NORGE',STEPRES));
RESULTAT('%SCEN%','MC','OVER',F)       = SUM(STEPRES, RESNORGE('MC','OVER',F,STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','MC','GHG','NORGE')  = SUM(STEPRES, RESNORGE('MC','GHG','NORGE',STEPRES)) ;
RESULTAT('%SCEN%','MC','DIETT','NORGE')= SUM(STEPRES, RESNORGE('MC','DIETT','NORGE',STEPRES)) ;
*
RESULTAT('%SCEN%','LV','AREA','NORGE') = SUM(STEPRES, RESNORGE('LV','AREA','NORGE',STEPRES));
RESULTAT('%SCEN%','LV','AREA',M)       = SUM(STEPRES, RESNORGE('LV','AREA',M,STEPRES)) ;
RESULTAT('%SCEN%','LV','KORN','NORGE') = SUM(STEPRES, RESNORGE('LV','KORN','NORGE',STEPRES));
RESULTAT('%SCEN%','LV','KORN',M)       = SUM(STEPRES, RESNORGE('LV','KORN',M,STEPRES)) ;
RESULTAT('%SCEN%','LV',PRDK,'NORGE')   = SUM(STEPRES, RESNORGE('LV',PRDK,'NORGE',STEPRES)) ;
RESULTAT('%SCEN%','LV',PRDK,M)         = SUM(STEPRES, RESNORGE('LV',PRDK,M,STEPRES)) ;
RESULTAT('%SCEN%','LV','ARBF','NORGE') = SUM(STEPRES, RESNORGE('LV','ARBF','NORGE',STEPRES));
RESULTAT('%SCEN%','LV','OVER',F)       = SUM(STEPRES, RESNORGE('LV','OVER',F,STEPRES)) ;
RESULTAT('%SCEN%','LV','GHG','NORGE')  = SUM(STEPRES, RESNORGE('LV','GHG','NORGE',STEPRES)) ;
RESULTAT('%SCEN%','LV','DIETT','NORGE')= SUM(STEPRES, RESNORGE('LV','DIETT','NORGE',STEPRES)) ;
