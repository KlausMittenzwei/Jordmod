RESULTAT('%SCEN%','NORGE',SSLK,'MNGD') $ SUM(M, RESULTAT('%SCEN%',M,'SSLK','OMFG')) = SUM(M, RESULTAT('%SCEN%',M,SSLK,'MNGD') * RESULTAT('%SCEN%',M,'SSLK','OMFG')) / SUM(M, RESULTAT('%SCEN%',M,'SSLK','OMFG'));
