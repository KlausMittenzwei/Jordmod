RESULTAT('%SCEN%','SLKK',FSLK,'MNGD') = SUM((M,STEPRES), RESNORGE(M,FSLK,'MNGD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK',SSLK,'PRIS') $ RESULTAT('%SCEN%','SLKK',SSLK,'MNGD') = RESULTAT('%SCEN%','SLKK',SSLK,'VERD') / RESULTAT('%SCEN%','SLKK',SSLK,'MNGD');
RESULTAT('%SCEN%','SLKK',FSLK,'PRIS') $ RESULTAT('%SCEN%','SLKK',FSLK,'MNGD') = RESULTAT('%SCEN%','SLKK',FSLK,'VERD') / RESULTAT('%SCEN%','SLKK',FSLK,'MNGD');
RESULTAT('%SCEN%','SLKK','SSLK','VERD') = SUM(SSLK, RESULTAT('%SCEN%','SLKK',SSLK,'VERD'));
RESULTAT('%SCEN%','SLKK','FSLK','VERD') = SUM(FSLK, RESULTAT('%SCEN%','SLKK',FSLK,'VERD'));
RESULTAT('%SCEN%','SLKK','SSLK','MNGD') = SUM(SSLK, RESULTAT('%SCEN%','SLKK',SSLK,'MNGD'));
RESULTAT('%SCEN%','SLKK','FSLK','MNGD') = SUM(FSLK, RESULTAT('%SCEN%','SLKK',FSLK,'MNGD'));
RESULTAT('%SCEN%','SLKK','SSLK','PRIS') $ RESULTAT('%SCEN%','SLKK','SSLK','MNGD') = RESULTAT('%SCEN%','SLKK','SSLK','VERD') / RESULTAT('%SCEN%','SLKK','SSLK','MNGD');
RESULTAT('%SCEN%','SLKK','FSLK','PRIS') $ RESULTAT('%SCEN%','SLKK','FSLK','MNGD') = RESULTAT('%SCEN%','SLKK','FSLK','VERD') / RESULTAT('%SCEN%','SLKK','FSLK','MNGD');
RESULTAT('%SCEN%','SLKK',SSLK,'AKSV') = SUM(STEPRES, RESNORGE('SLKK',SSLK,'AKST',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK',SSLK,'AKSM') = RESULTAT('%SCEN%','SLKK',SSLK,'MNGD');
RESULTAT('%SCEN%','SLKK',SSLK,'AKSP') $ RESULTAT('%SCEN%','SLKK',SSLK,'AKSM') = RESULTAT('%SCEN%','SLKK',SSLK,'AKSV') / RESULTAT('%SCEN%','SLKK',SSLK,'AKSM');
RESULTAT('%SCEN%','SLKK','SSLK','AKSV') = SUM(SSLK, RESULTAT('%SCEN%','SLKK',SSLK,'AKSV'));
RESULTAT('%SCEN%','SLKK','SSLK','AKSM') = SUM(SSLK, RESULTAT('%SCEN%','SLKK',SSLK,'AKSM'));
RESULTAT('%SCEN%','SLKK','SSLK','AKSP') $ RESULTAT('%SCEN%','SLKK','SSLK','AKSM') = RESULTAT('%SCEN%','SLKK','SSLK','AKSV') / RESULTAT('%SCEN%','SLKK','SSLK','AKSM');
RESULTAT('%SCEN%','SLKK','IUTG','VERD') = SUM((STEPRES,VARE), RESNORGE('SLKK',VARE,'IUTG',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK','IUTQ','VERD') = SUM((STEPRES,VARE), RESNORGE('SLKK',VARE,'IUTQ',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK','SSLK','IKSV') = SUM((STEPRES,SSLK), RESNORGE('SLKK',SSLK,'IKST',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK','SSLK','IKSM') = SUM((STEPRES,SLKINNVARE), RESNORGE('PROD',SLKINNVARE,'MNGD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK','SSLK','IKSP') $ RESULTAT('%SCEN%','SLKK','SSLK','IKSM') = RESULTAT('%SCEN%','SLKK','SSLK','IKSV') / RESULTAT('%SCEN%','SLKK','SSLK','IKSM');
RESULTAT('%SCEN%','SLKK','TRSP','VERD') = SUM(STEPRES, RESNORGE('SLKK','TRSP','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK',VARE,'RAAV') $ SLKINNVARE(VARE) = SUM(STEPRES, RESNORGE('SLKK',VARE,'RAAV',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK',VARE,'RAAM') $ SLKINNVARE(VARE) = SUM(STEPRES, RESNORGE('PROD',VARE,'MNGD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK',VARE,'RAAP') $ RESULTAT('%SCEN%','SLKK',VARE,'RAAM') = RESULTAT('%SCEN%','SLKK',VARE,'RAAV') / RESULTAT('%SCEN%','SLKK',VARE,'RAAM');
RESULTAT('%SCEN%','SLKK','VARE','RAAV') = SUM(VARE, RESULTAT('%SCEN%','SLKK',VARE,'RAAV'));
RESULTAT('%SCEN%','SLKK','VARE','RAAM') = SUM(VARE, RESULTAT('%SCEN%','SLKK',VARE,'RAAM'));
RESULTAT('%SCEN%','SLKK','VARE','RAAP') $ RESULTAT('%SCEN%','SLKK','VARE','RAAM') = RESULTAT('%SCEN%','SLKK','VARE','RAAV') / RESULTAT('%SCEN%','SLKK','VARE','RAAM');
RESULTAT('%SCEN%','SLKK',SSLK,'NTIU') = SUM(STEPRES, RESNORGE('SLKK',SSLK,'NTIU',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK','NTIU','VERD') = SUM(STEPRES, RESNORGE('SLKK','NTIU','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK','NTIU','PRIS') $ SUM(SSLK, RESULTAT('%SCEN%','SLKK',SSLK,'MNGD')) = RESULTAT('%SCEN%','SLKK','NTIU','VERD') /  SUM(SSLK, RESULTAT('%SCEN%','SLKK',SSLK,'MNGD'));
RESULTAT('%SCEN%','SLKK',SSLK,'IUVD') =  RESULTAT('%SCEN%','SLKK',SSLK,'NTIU') * RESULTAT('%SCEN%','SLKK',SSLK,'OMSM');
RESULTAT('%SCEN%','SLKK',VARE,'IKSV') = SUM(STEPRES, RESNORGE('SLKK',VARE,'IUTG',STEPRES)) / CARD(STEPRES) + SUM(STEPRES, RESNORGE('SLKK',VARE,'IUTQ',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK',VARE,'IKSM') $ (SLKINNVARE(VARE) OR SLKVARE(VARE)) = SUM(STEPRES, RESNORGE('IMPO',VARE,'MNGD',STEPRES)) / CARD(STEPRES)
                             + SUM(STEPRES, RESNORGE('IMPQ',VARE,'MNGD',STEPRES)) / CARD(STEPRES) + SUM(STEPRES, RESNORGE('IMPA',VARE,'MNGD',STEPRES)) / CARD(STEPRES)
                             + SUM(STEPRES, RESNORGE('IMPB',VARE,'MNGD',STEPRES)) / CARD(STEPRES) + SUM(STEPRES, RESNORGE('IMPS',VARE,'MNGD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK',VARE,'IKSP') $ RESULTAT('%SCEN%','SLKK',VARE,'IKSM') = RESULTAT('%SCEN%','SLKK',VARE,'IKSV') / RESULTAT('%SCEN%','SLKK',VARE,'IKSM');
RESULTAT('%SCEN%','SLKK','VARE','IKSV') = SUM(VARE, RESULTAT('%SCEN%','SLKK',VARE,'IKSV'));
RESULTAT('%SCEN%','SLKK','VARE','IKSM') = SUM(VARE, RESULTAT('%SCEN%','SLKK',VARE,'IKSM'));
RESULTAT('%SCEN%','SLKK','VARE','IKSP') $ RESULTAT('%SCEN%','SLKK','VARE','IKSM') = RESULTAT('%SCEN%','SLKK','VARE','IKSV') / RESULTAT('%SCEN%','SLKK','VARE','IKSM');
RESULTAT('%SCEN%','SLKK','FRDL','VERD') = RESULTAT('%SCEN%','SLKK','SSLK','VERD') + RESULTAT('%SCEN%','SLKK','FSLK','VERD') + RESULTAT('%SCEN%','SLKK','VARE','OMSV');
RESULTAT('%SCEN%','SLKK','MAIM','VERD') = SUM(STEPRES, RESNORGE('SLKK','MAIM','VERD',STEPRES)) / CARD(STEPRES);
RESULTAT('%SCEN%','SLKK','KOST','VERD') = RESULTAT('%SCEN%','SLKK','FRDL','VERD') + RESULTAT('%SCEN%','SLKK','VARE','IKSV')
                               + RESULTAT('%SCEN%','SLKK','TRSP','VERD') + RESULTAT('%SCEN%','SLKK','VARE','RAAV') + RESULTAT('%SCEN%','SLKK','MAIM','VERD');
RESULTAT('%SCEN%','SLKK','VARE','INNT') =  RESULTAT('%SCEN%','SLKK','VARE','INTV') + RESULTAT('%SCEN%','SLKK','VARE','EKSV');
RESULTAT('%SCEN%','SLKK','PROF','VERD') =  RESULTAT('%SCEN%','SLKK','VARE','INNT') - RESULTAT('%SCEN%','SLKK','KOST','VERD')
                               + RESULTAT('%SCEN%','SLKK','VARE','TFRKV') + RESULTAT('%SCEN%','SLKK','NTIU','VERD');
