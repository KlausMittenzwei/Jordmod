{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "GAMS: Run current file",
            "type": "shell",
            "command": "gams",
            "args": [
                "\"${file}\"",
                "curDir=\"${fileDirname}\"",
                "lo=3"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "GAMS: Run jordmod.gms",
            "type": "shell",
            "command": "gams",
            "args": [
                "jordmod.gms",
                "lo=3"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
