TRINN(TILSKUDD,'ARBF',TTIL)      = SUM(TBASAAR, P_TRINN(TBASAAR,TILSKUDD,'ARBF',TTIL));


PARAMETER BUNNFRADRAG(TILSKUDD)
          MAKSSATS(TILSKUDD)
;
BUNNFRADRAG(TILSKUDD) = SUM(TBASAAR, p_BUNNFRADRAG(TILSKUDD,TBASAAR));
MAKSSATS(TILSKUDD)    = SUM(TBASAAR, p_MAKSSATS(TILSKUDD,TBASAAR));

