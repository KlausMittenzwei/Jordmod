SATSER(TILSKUDD,VARE,TTIL,'0')   = SUM(TBASAAR, P_SATSER(TBASAAR,TILSKUDD,VARE,TTIL,'0'))   ;
SATSER(TILSKUDD,PRDK,TTIL,'0')   = SUM(TBASAAR, P_SATSER(TBASAAR,TILSKUDD,PRDK,TTIL,'0'))   ;
