SATSER(TILSKUDD,'KORN',TTIL,'0') = SUM(TBASAAR, P_SATSER(TBASAAR,TILSKUDD,'KORN',TTIL,'0')) ;
SATSER(TILSKUDD,'GAKF',TTIL,'0') = SUM(TBASAAR, P_SATSER(TBASAAR,TILSKUDD,'GAKF',TTIL,'0')) ;
SATSER(TILSKUDD,'GAKR',TTIL,'0') = SUM(TBASAAR, P_SATSER(TBASAAR,TILSKUDD,'GAKR',TTIL,'0')) ;
SATSER(TILSKUDD,'ARBF',TTIL,'0') = SUM(TBASAAR, P_SATSER(TBASAAR,TILSKUDD,'ARBF',TTIL,'0')) ;
                                             
TRINN(TILSKUDD,VARE,TTIL)        = SUM(TBASAAR, P_TRINN(TBASAAR,TILSKUDD,VARE,TTIL));
