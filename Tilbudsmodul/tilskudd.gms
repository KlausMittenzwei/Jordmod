*
* Andre tilskudd
* implementert som flate ikke-regionaliserte tilskudd i forhold til ATILVEKT
* kalibrert til 1 gjoedseldyrenhet pr 3 daa
PARAMETER ATILVEKT(PRDK)  Vekt for andre tilskudd  /
       HVEM   .333
       HVEF   .333
       RUGM   .333
       RUGF   .333
       BYGM   .333
       BYGF   .333
       HAVM   .333
       HAVF   .333
       AKRM   .333
       AKRF   .333
       RAPM   .333
       RAPF   .333
       ERTM   .333
       ERTF   .333
       POTE   .333
       GRNV   .333
       GRNF   .333
       EPLE   .333
       AFRU   .333
       BLOM   .333
*       APLN   .333
       GFFS   .333
       GFFB   .333
       GFOS   .333
       GFOB   .333
       GFIB   .333
       GFUB   0
       BRAK   0
       MKYR   1.000
       AKYR   0.750
       OKSS   0.333
       KVGS   0.333
       KVGO   0.333
       OKKS   0.165
       KVKS   0.165
       OKKO   0.165
       KVKO   0.165
       GRIS   0.056
       PURK   0.400
       SOEY   0.143
       LAMS   0.071
       GEIT   0.143
       KJES   0.071
* Fjoerfe er angitt i 1000 dyr
       HOEN   12.5
       KYLS   0.714
/;

* Scale GRIS since they are defined as fattened pigs per year not at counting date used 2.3 births per year
ATILVEKT('GRIS') = ATILVEKT('GRIS') / 2.3;
P_SATSER(T,TILSKUDD,'GRIS',TTIL,'0') = P_SATSER(T,TILSKUDD,'GRIS',TTIL,'0') / 2.3;
P_SATSER(T,TILSKUDD,'GRIS',TTIL,R)   = P_SATSER(T,TILSKUDD,'GRIS',TTIL,R)   / 2.3;
*
*
P_SATSER(T,'TATIL',PRDK,'0','0') $ DATA('NORGE',PRDK,'OMFG','BAS') =

  TOTVERDBAS('TATIL','NORGE')
  *               DATA('NORGE',PRDK,'OMFG','BAS')     * ATILVEKT(PRDK) 
  / SUM(PRDKPRDK, DATA('NORGE',PRDKPRDK,'OMFG','BAS') * ATILVEKT(PRDKPRDK))
  /               DATA('NORGE',PRDK,'OMFG','BAS');
  
*P_SATSER(T,'TATIL',PRDK,'0','0') $ DATA('NORGE',PRDK,'OMFG','BAS') = 100 * P_SATSER(T,'TATIL',PRDK,'0','0') / DATA('NORGE',PRDK,'OMFG','BAS') ;
*
* General scaling ATIL
P_SATSER(T,'TATIL',PRDK,'0','0') = P_SATSER(T,'TATIL',PRDK,'0','0') * .001 * 0.80;
* General scaling TGRUN
P_SATSER(T,'TGRUN',VARE,'0','0') = P_SATSER(T,'TGRUN',VARE,'0','0') * .001 ;
*
* Jordbruksfradrag: Sats p� marginalskatt
* BFJ. Totalkalkylen. 2025: Tabell 6.3
P_SATSER('2024','TSKAT','MARG','0','0') = .397;
*
* Jordbruksfradrag: Sats p� skatt p� alminnelig inntekt
* To be checked
P_SATSER('2024','TSKAT','ALMI','0','0') = .38;

execute_unload 'p_satser0.gdx', p_satser, p_trinn;
