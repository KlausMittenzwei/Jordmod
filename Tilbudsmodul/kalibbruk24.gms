ENDOKOEFF(R,'SOEY','ARBP')  = ENDOKOEFF(R,'SOEY','ARBP') * 1;
ENDOKOEFF(R,'BSAU','ARBP')  = -5000;
ENDOKOEFF(R,'SOEY','VETM')  = ENDOKOEFF(R,'SOEY','VETM') * .5;
ENDOKOEFF(R,'BSAU','VETM')  = ENDOKOEFF(R,'BSAU','VETM') * .5;
*
* BAKY
*ENDOKOEFF(R,'BAKY','PLVR')  = ENDOKOEFF(R,'BAKY','PLVR') * 0 + .5;
ENDOKOEFF(R,'BAKY','VEDM')  = ENDOKOEFF(R,'BAKY','VEDM') * .5;
ENDOKOEFF(R,'AKYR','VEDM')  = ENDOKOEFF(R,'AKYR','VEDM') * .05;
ENDOKOEFF(R,'BAKY','VEDB')  = ENDOKOEFF(R,'BAKY','VEDB') * .05;
ENDOKOEFF(R,'AKYR','VEDB')  = ENDOKOEFF(R,'AKYR','VEDB') * .025;
ENDOKOEFF(R,'BAKY','KAPM')  = ENDOKOEFF(R,'BAKY','KAPM') * .33;
ENDOKOEFF(R,'AKYR','KAPM')  = ENDOKOEFF(R,'AKYR','KAPM') * .33;
ENDOKOEFF(R,'BAKY','KAPB')  = ENDOKOEFF(R,'BAKY','KAPB') * .33;
ENDOKOEFF(R,'AKYR','KAPB')  = ENDOKOEFF(R,'AKYR','KAPB') * .33;
ENDOKOEFF(R,'BAKY','AKST')  = ENDOKOEFF(R,'BAKY','AKST') * .05;
ENDOKOEFF(R,'AKYR','AKST')  = ENDOKOEFF(R,'AKYR','AKST') * .5;
ENDOKOEFF(R,'BAKY','ARBT')  = ENDOKOEFF(R,'BAKY','ARBT') * .5;
ENDOKOEFF(R,'AKYR','ARBT')  = ENDOKOEFF(R,'AKYR','ARBT') * .5;
ENDOKOEFF(R,'AKYR','ARBP')  = ENDOKOEFF(R,'AKYR','ARBP') * 1.2;
ENDOKOEFF(R,'BAKY','ARBP')  = -5000;
ENDOKOEFF(R,'AKYR','VETM')  = ENDOKOEFF(R,'AKYR','VETM') * .25;
ENDOKOEFF(R,'BAKY','VETM')  = ENDOKOEFF(R,'BAKY','VETM') * .75;
*
* BGRI
*ENDOKOEFF(R,'BGRI','PLVR')  = 0;
ENDOKOEFF(R,'PURK','ARBT')  = ENDOKOEFF(R,'PURK','ARBT') * 1.;
ENDOKOEFF(R,'GRIS','ARBT')  = ENDOKOEFF(R,'GRIS','ARBT') * 1.;
ENDOKOEFF(R,'BGRI','ARBT')  = ENDOKOEFF(R,'BGRI','ARBT') * 1.;
ENDOKOEFF(R,'PURK','ARBP')  = ENDOKOEFF(R,'PURK','ARBP') * 5.;
ENDOKOEFF(R,'GRIS','ARBP')  = ENDOKOEFF(R,'PURK','ARBP') / ENHDATA(R,'IPRK','PURK','BAS');
ENDOKOEFF(R,'BGRI','ARBP')  = -25000;
ENDOKOEFF(R,'GRIS','KAPB')  = ENDOKOEFF(R,'GRIS','KAPB') * .15;
ENDOKOEFF(R,'BGRI','KAPB')  = ENDOKOEFF(R,'BGRI','KAPB') * .15;
ENDOKOEFF(R,'GRIS','KAPM')  = ENDOKOEFF(R,'GRIS','KAPM') * .15;
ENDOKOEFF(R,'BGRI','KAPM')  = ENDOKOEFF(R,'BGRI','KAPM') * .15;
*
* BHOE
*ENDOKOEFF(R,'BHOE','PLVR')  = 0;
ENDOKOEFF(R,'HOEN','VEDM')  = ENDOKOEFF(R,'HOEN','VEDM') * 5;
