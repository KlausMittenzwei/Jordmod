ENDOKOEFF(R,'SOEY','KAPB')  = ENDOKOEFF(R,'SOEY','KAPB') * .75;
ENDOKOEFF(R,'BSAU','AKST')  = ENDOKOEFF(R,'BSAU','AKST') * .05;
