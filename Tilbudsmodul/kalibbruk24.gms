ENDOKOEFF(R,'BKYL','KAPB')  = ENDOKOEFF(R,'BKYL','KAPB') * 1;
ENDOKOEFF(R,'KYLS','KAPB')  = ENDOKOEFF(R,'BKYL','KAPB') * 1;
ENDOKOEFF(R,'KYLS','KAPM')  = ENDOKOEFF(R,'KYLS','KAPM') * 1;
ENDOKOEFF(R,'BKYL','KAPM')  = ENDOKOEFF(R,'BKYL','KAPM') * 1;
ENDOKOEFF(R,'KYLS','ARBT')  = ENDOKOEFF(R,'KYLS','ARBT') * 1;
ENDOKOEFF(R,'BKYL','ARBT')  =                              100;
ENDOKOEFF(R,'KYLS','ARBP')  = ENDOKOEFF(R,'KYLS','ARBP') * .5 ;
ENDOKOEFF(R,'BKYL','ARBP')  = -1500000;
*
* Final calibration of labour requirement
*ENDOKOEFF(R,PRDK,'ARBT')  = ENDOKOEFF(R,PRDK,'ARBT') * 1;
*ENDOKOEFF(R,KORN,'ARBT')  = ENDOKOEFF(R,KORN,'ARBT') * 1;
*ENDOKOEFF(R,FRBA,'ARBT')  = ENDOKOEFF(R,FRBA,'ARBT') * 1;
*ENDOKOEFF(R,B,'ARBT')  = ENDOKOEFF(R,B,'ARBT') * 1;
*ENDOKOEFF(R,'POTE','ARBT')  = ENDOKOEFF(R,'POTE','ARBT') * 1;
**
*ENDOKOEFF(R,KORN,'ARBT')  = ENDOKOEFF(R,KORN,'ARBT') * 1;
*ENDOKOEFF(R,GRNS,'ARBT')  = ENDOKOEFF(R,GRNS,'ARBT') * 1;
*ENDOKOEFF(R,UNGD,'ARBT')  = ENDOKOEFF(R,UNGD,'ARBT') * 1;
