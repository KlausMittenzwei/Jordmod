ENDOKOEFF(R,'BKMK','VEDM')  = ENDOKOEFF(R,'BKMK','VEDM') * .5;
ENDOKOEFF(R,'MKYR','VEDM')  = ENDOKOEFF(R,'MKYR','VEDM') * .15;
ENDOKOEFF(R,'BKMK','VEDB')  = ENDOKOEFF(R,'BKMK','VEDB') * .5;
