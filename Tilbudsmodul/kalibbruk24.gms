************************************************************************
SCALAR KALIBSKATT Fra vederlag fam.arbeid og kapital til n�ringsinntekt / .08 /;
*
*************************************************************************
* Brukstoerrelse til kalibrering
************************************************************************
BRUKSTOR(R,'BKRN','KALB','BAS') =  350;
BRUKSTOR(R,'BPTE','KALB','BAS') =  80 ;
BRUKSTOR(R,'BFRK','KALB','BAS') =  30 ;
BRUKSTOR(R,'BHGE','KALB','BAS') =  21 ;
BRUKSTOR(R,'BKMK','KALB','BAS') =  25 ;
BRUKSTOR(R,'BGMK','KALB','BAS') =  90 ;
BRUKSTOR(R,'BAKY','KALB','BAS') =  20 ;
BRUKSTOR(R,'BSAU','KALB','BAS') =  80 ;
BRUKSTOR(R,'BGRI','KALB','BAS') =  20 ;
