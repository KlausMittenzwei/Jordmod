ENDOKOEFF(R,'BSAU','VEDM')  = ENDOKOEFF(R,'BSAU','VEDM') * .05;
ENDOKOEFF(R,'SOEY','VEDM')  = ENDOKOEFF(R,'SOEY','VEDM') * .05;
ENDOKOEFF(R,'BSAU','VEDB')  = ENDOKOEFF(R,'BSAU','VEDB') * .05;
ENDOKOEFF(R,'SOEY','VEDB')  = ENDOKOEFF(R,'SOEY','VEDB') * .05;
ENDOKOEFF(R,'BSAU','KAPM')  = ENDOKOEFF(R,'BSAU','KAPM') * .75;
ENDOKOEFF(R,'SOEY','KAPM')  = ENDOKOEFF(R,'SOEY','KAPM') * .75;
