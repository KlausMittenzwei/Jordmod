ENDOKOEFF(R,'BHOE','KAPB')  =  50000;
ENDOKOEFF(R,'HOEN','KAPM')  = ENDOKOEFF(R,'HOEN','KAPM') * .25;
ENDOKOEFF(R,'BHOE','KAPM')  =  15000;
ENDOKOEFF(R,'HOEN','ARBT')  = ENDOKOEFF(R,'HOEN','ARBT') * .75;
ENDOKOEFF(R,'BHOE','ARBT')  =                            15;
ENDOKOEFF(R,'HOEN','ARBP')  = ENDOKOEFF(R,'HOEN','ARBP') * .5;
ENDOKOEFF(R,'BHOE','ARBP')  = -1100000;
ENDOKOEFF(R,'HOEN','AKST')  = ENDOKOEFF(R,'HOEN','AKST') * 4;
ENDOKOEFF(R,'BHOE','AKST')  = ENDOKOEFF(R,'BHOE','AKST') * .25;
*
* BKYL
*ENDOKOEFF(R,'BKYL','PLVR')  = 0;
ENDOKOEFF(R,'BKYL','VEDM')  = ENDOKOEFF(R,'BKYL','VEDM') * 3;
