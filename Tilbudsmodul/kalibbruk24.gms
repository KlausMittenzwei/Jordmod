ENDOKOEFF(R,'BGMK','VEDM')  = ENDOKOEFF(R,'BGMK','VEDM') * .25;
ENDOKOEFF(R,'GEIT','VEDM')  = ENDOKOEFF(R,'GEIT','VEDM') * .25;
ENDOKOEFF(R,'BGMK','VEDB')  = ENDOKOEFF(R,'BGMK','VEDB') * .25;
ENDOKOEFF(R,'GEIT','VEDB')  = ENDOKOEFF(R,'GEIT','VEDB') * .25;
ENDOKOEFF(R,'BGMK','KAPM')  = ENDOKOEFF(R,'BGMK','KAPM') * .15;
