* Omregne til regionsniv�
GROVAVL(GROV,'0',R) = SUM(DG$R_TIL_DG(DG,R), GROVAVL(GROV,'0',DG));
GROVAVL(GROV,'1',R) = SUM(DG$R_TIL_DG(DG,R), GROVAVL(GROV,'1',DG));
GROVAVL(GROV,'2',R) = SUM(DG$R_TIL_DG(DG,R), GROVAVL(GROV,'2',DG));
*
* Calibration of regional gras yields by type according to calibration
Table GrovAvlCalib(Grov,DG)
       001100  001200  002100  002200  003200  004100  004200  005200
GFFS    0.8504  0.6302  1.1750  0.9522  0.9295  0.7724  0.7555  1.0607
GFFB    0.8007  0.5956  1.0966  0.8887  0.8735  0.7428  0.7149  1.0052
GFOS    0.7589  0.5683  1.1853  0.8785  1.2853  0.7939  0.6000  1.0260
GFOB    0.7464  0.5683  1.0942  0.8257  1.1898  0.7411  0.5901  1.0102
GFIB    0.9009  0.6219  1.1100  1.0736  1.1134  0.8010  0.6752  0.9802
;
GrovAvlCalib(Grov,DG) = GrovAvlCalib(Grov,DG) * 1.;
GROVAVL(GROV,'1',R) = GROVAVL(GROV,'1',R) * sum(DG $ R_Til_DG(DG,R), GrovAvlCalib(Grov,DG));
*
* Calculation of constant term to base year yields
GROVAVL('GFFS','0',R) = ENHDATA(R,'GFFS','GFFS','BAS') - (GROVAVL('GFFS','1',R)* ENHDATA(R,'NITR','GFFS','BAS') + GROVAVL('GFFS','2',R) * ENHDATA(R,'NITR','GFFS','BAS')**2);
GROVAVL('GFFB','0',R) = ENHDATA(R,'GFFB','GFFB','BAS') - (GROVAVL('GFFB','1',R)* ENHDATA(R,'NITR','GFFB','BAS') + GROVAVL('GFFB','2',R) * ENHDATA(R,'NITR','GFFB','BAS')**2);
GROVAVL('GFOS','0',R) = ENHDATA(R,'GFOS','GFOS','BAS') - (GROVAVL('GFOS','1',R)* ENHDATA(R,'NITR','GFOS','BAS') + GROVAVL('GFOS','2',R) * ENHDATA(R,'NITR','GFOS','BAS')**2);
GROVAVL('GFOB','0',R) = ENHDATA(R,'GFOB','GFOB','BAS') - (GROVAVL('GFOB','1',R)* ENHDATA(R,'NITR','GFOB','BAS') + GROVAVL('GFOB','2',R) * ENHDATA(R,'NITR','GFOB','BAS')**2);
GROVAVL('GFIB','0',R) = ENHDATA(R,'GFIB','GFIB','BAS') - (GROVAVL('GFIB','1',R)* ENHDATA(R,'NITR','GFIB','BAS') + GROVAVL('GFIB','2',R) * ENHDATA(R,'NITR','GFIB','BAS')**2);
*
* Regional scaling so that no additional fodder area is necessary during calibration
GROVAVL(GROV,'1',R) = GROVAVL(GROV,'1',R) * .98;
GROVAVL(GROV,'1','041101') = GROVAVL(GROV,'1','041101') / .98 * 1.1;
GROVAVL(GROV,'1','061101') = GROVAVL(GROV,'1','061101') / .98 * 1.025;
GROVAVL(GROV,'1','10225A') = GROVAVL(GROV,'1','10225A') / .98 * 1.2;
GROVAVL(GROV,'1','112102') = GROVAVL(GROV,'1','112102') / .98 * 1.35;
GROVAVL(GROV,'1','112203') = GROVAVL(GROV,'1','112203') / .98 * 1.05;
GROVAVL(GROV,'1','12325B') = GROVAVL(GROV,'1','12325B') / .98 * 1.05;
GROVAVL(GROV,'1','195206') = GROVAVL(GROV,'1','195206') / .98 * 1.05;
GROVAVL(GROV,'1','205207') = GROVAVL(GROV,'1','205207') / .98 * 1.075;
*
* Kalibrering av nitrogenmengde
SCALAR KALIBAVLKORN Kalibrering av nitrogen til korn    /1/;
SCALAR KALIBAVLGRAS Kalibrering av nitrogen til grovf�r /1/;
*
* Fremskriving avlingsniv�
GROVAVL(GROV,'0',R) = GROVAVL(GROV,'0',R)  * (1 + VEKSTGROV/100) ** (Y - %BAS%);
GROVAVL(GROV,'1',R) = GROVAVL(GROV,'1',R)  * (1 + VEKSTGROV/100) ** (Y - %BAS%);
GROVAVL(GROV,'2',R) = GROVAVL(GROV,'2',R)  * (1 + VEKSTGROV/100) ** (Y - %BAS%);
