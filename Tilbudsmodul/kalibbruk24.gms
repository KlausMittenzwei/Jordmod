*
************************************************************************
* Definisjon av intensitet i planteproduksjonen
************************************************************************
SET PARAPLANTE Parametrisering av avlingsfunksjoner i planteproduksjonen /APL, BPL, EPL/ ;
PARAMETER INTPL(R,PARAPLANTE,PRDK) Intensitetsparametre i planteproduksjonen ;
INTPL(R,'APL','HVEM') = ENHDATA(R,'HVEM','HVEM','BAS') * (1 + VEKSTKORN/100) ** (Y - %BAS%);
INTPL(R,'APL','HVEF') = ENHDATA(R,'HVEF','HVEF','BAS') * (1 + VEKSTKORN/100) ** (Y - %BAS%);
INTPL(R,'APL','RUGM') = ENHDATA(R,'RUGM','RUGM','BAS') * (1 + VEKSTKORN/100) ** (Y - %BAS%);
INTPL(R,'APL','RUGF') = ENHDATA(R,'RUGF','RUGF','BAS') * (1 + VEKSTKORN/100) ** (Y - %BAS%);
INTPL(R,'APL','BYGM') = ENHDATA(R,'BYGM','BYGM','BAS') * (1 + VEKSTKORN/100) ** (Y - %BAS%);
INTPL(R,'APL','BYGF') = ENHDATA(R,'BYGF','BYGF','BAS') * (1 + VEKSTKORN/100) ** (Y - %BAS%);
INTPL(R,'APL','HAVM') = ENHDATA(R,'HAVM','HAVM','BAS') * (1 + VEKSTKORN/100) ** (Y - %BAS%);
INTPL(R,'APL','HAVF') = ENHDATA(R,'HAVF','HAVF','BAS') * (1 + VEKSTKORN/100) ** (Y - %BAS%);
INTPL(R,'APL','AKRM') = ENHDATA(R,'AKRM','AKRM','BAS') * (1 + VEKSTKORN/100) ** (Y - %BAS%);
INTPL(R,'APL','AKRF') = ENHDATA(R,'AKRF','AKRF','BAS') * (1 + VEKSTKORN/100) ** (Y - %BAS%);
*
INTPL(R,'BPL',KORN) = 0.001;
*
INTPL(R,'EPL','HVEM') = 1.933;
INTPL(R,'EPL','HVEF') = 1.933;
INTPL(R,'EPL','RUGM') = 1.933;
INTPL(R,'EPL','RUGF') = 1.933;
INTPL(R,'EPL','BYGM') = 1.846;
INTPL(R,'EPL','BYGF') = 1.846;
INTPL(R,'EPL','HAVM') = 1.846;
INTPL(R,'EPL','HAVF') = 1.846;
INTPL(R,'EPL','AKRM') = 1.845;
INTPL(R,'EPL','AKRF') = 1.845;
*
* Kalibrering nasjonal kornproduksjon
* Kilde: kalibrering.xlsx
INTPL(R,'APL',KORN) = INTPL(R,'APL',KORN) * .84 * .98;

INTPL(R,'BPL',KORN) = INTPL(R,'BPL',KORN) * .29;
INTPL(R,'EPL',KORN) = INTPL(R,'EPL',KORN) *  1;
* Kalibrering regional kornproduksjon
INTPL(R,'APL',KORN) = (INTPL(R,'APL',KORN) * 1.25) $ R_TIL_DG('001100',R)
                    + (INTPL(R,'APL',KORN) * 1.) $ R_TIL_DG('001200',R)
                    + (INTPL(R,'APL',KORN) * 1.25) $ R_TIL_DG('002100',R)
                    + (INTPL(R,'APL',KORN) * 1.) $ R_TIL_DG('002200',R)
*
                    + (INTPL(R,'APL',KORN) * 1) $ R_TIL_DG('003200',R)
                    + (INTPL(R,'APL',KORN) * 1) $ R_TIL_DG('004100',R)
                    + (INTPL(R,'APL',KORN) * 1) $ R_TIL_DG('004200',R)
                    + (INTPL(R,'APL',KORN) * 1) $ R_TIL_DG('005200',R);
*

* Kalibrering av regionalt minimumsavlingsnivaa i kornproduksjon
PARAMETER MINAVL(PRDK,R) Minimumsavlingsnivaa i planteproduksjonen og region;
* Korn
MINAVL(KORN,R) = 50;
*
* Kilde: kalibgrov.xlsx
