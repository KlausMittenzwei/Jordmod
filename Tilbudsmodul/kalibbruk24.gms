*ENDOKOEFF(R,'SOEY','ARBT')  = ENDOKOEFF(R,'SOEY','ARBT') * 1;
*ENDOKOEFF(R,'HOEN','ARBT')  = ENDOKOEFF(R,'HOEN','ARBT') * 1;
*ENDOKOEFF(R,'KYLS','ARBT')  = ENDOKOEFF(R,'KYLS','ARBT') * 1;
*
* Calibration to aim at low and negative pmp-terms
*TABLE RefBrukCorrFact(DGVARE,B)
*       BKRN    BPTE    BFRK    BHGE    BKMK    BGMK    BAKY    BSAU    BGRI    BHOE    BKYL
*PLVR    2.0462  1.9149  0.5001  0.6264  0.8602  1.2001  0.3502  0.6861          
*VETM                    0.7947  0.4631  1.4837  1.2255  0.8906      
*VEDB    2.6972  0.6914  0.3294  0.1540  0.8732  0.8860  0.3397  0.9820  1.6348  0.5565  1.0708
*VEDM    9.1742  5.4978  0.2930  0.2083  0.7495  1.1683  0.5679  1.4270  0.9533  0.7629  0.5646
*;
*ENDOKOEFF(R,PRDK,DGVARE) $ (SUM(B$B_TIL_HRDK(B,PRDK), RefBrukCorrFact(DGVARE,B)) > 0)  = ENDOKOEFF(R,PRDK,DGVARE) * SUM(B$B_TIL_HRDK(B,PRDK), RefBrukCorrFact(DGVARE,B));
*ENDOKOEFF(R,B,DGVARE)    $ (RefBrukCorrFact(DGVARE,B) > 0)  = ENDOKOEFF(R,B,DGVARE)    * RefBrukCorrFact(DGVARE,B);
*
*TABLE RefBrukEnerCorrFact(VARE,B)
*        BKRN    BPTE    BFRK    BHGE    BKMK    BGMK    BAKY    BSAU    BGRI    BHOE    BKYL
*EKRF    1.0075  1.00746 5.20189 0.1111  1.10652 1.11599 0.78135 1.15148 1.00749 1.0072  1.00754
*EBRN    0.99962 0.99975 1.0001  0.99603 0.89876 1.00401 1.20469 0.90968 1.00005 0.99962 1.00042
*;
*
*ENHDATA(R,'EKRF',PRDK,'Y') $ SUM(B$B_TIL_HRDK(B,PRDK), RefBrukEnerCorrFact('EKRF',B)) = ENHDATA(R,'EKRF',PRDK,'Y') * SUM(B$B_TIL_HRDK(B,PRDK), RefBrukEnerCorrFact('EKRF',B));
*ENHDATA(R,'EBRN',PRDK,'Y') $ SUM(B$B_TIL_HRDK(B,PRDK), RefBrukEnerCorrFact('EBRN',B)) = ENHDATA(R,'EBRN',PRDK,'Y') * SUM(B$B_TIL_HRDK(B,PRDK), RefBrukEnerCorrFact('EBRN',B));

ENHDATA(R,'EKRF',PRDK,'Y') = ENHDATA(R,'EKRF',PRDK,'Y') * 1.46461729 * 0.9645 * 0.9944 * 1.0041 * 0.9983;
ENHDATA(R,'EBRN',PRDK,'Y') = ENHDATA(R,'EBRN',PRDK,'Y') * 1.46461729 * 0.9645 * 0.9944 * 1.0041 * 0.9983; 
ENHDATA(R,'EFOL',PRDK,'Y') = ENHDATA(R,'EFOL',PRDK,'Y') * 1.46461729 * 0.9645 * 0.9944 * 1.0041 * 0.9983; 
ENHDATA(R,'ESMR',PRDK,'Y') = ENHDATA(R,'ESMR',PRDK,'Y') * 1.46461729 * 0.9645 * 0.9944 * 1.0041 * 0.9983; 


$ontext
     SET B_TIL_HRDK(B,PRDK) Hovedproduksjon for enkeltbruk i primaerjordbruket /
      BKRN.(HVEM,HVEF,RUGM,RUGF,BYGM,BYGF,HAVM,HAVF,AKRM,AKRF,RAPM,RAPF,ERTM,ERTF)  Bruk med korn og oljefroe
      BPTE.POTE  Bruk med potet og belgfrukter
      BFRK.(EPLE,AFRU)  Bruk med frukt og baer
      BHGE.(GRNV,GRNF,BLOM)  Bruk med groennsaker og blomster
*
*     ***   Husdyrproduksjon
      BKMK.MKYR  Bruk med melkekyr og salg av kalver
      BGMK.GEIT  Bruk med geiter
      BAKY.AKYR  Bruk med ammekyr
      BSAU.SOEY  Bruk med sauer
      BGRI.PURK  Bruk med griser
      BHOE.HOEN  Bruk med hoener
      BKYL.KYLS  Bruk med kyllinger
$offtext

*
* Final calibration of endogenous DG coeffs
ENDOKOEFF(R,PRDK,'ARBT') = ENDOKOEFF(R,PRDK,'ARBT') * 1.427946411 *  0.9052 * 0.9910 * 0.8880 * 1.1094  ;
ENDOKOEFF(R,PRDK,'PLVR') = ENDOKOEFF(R,PRDK,'PLVR') * 0.636459021 *  0.9891 * 0.9954 * 1.0506 * 1.0095 * 0.9949 * 0.9983;
ENDOKOEFF(R,PRDK,'VETM') = ENDOKOEFF(R,PRDK,'VETM') * 1.721790088 *  1.0032 * 0.9919 * 0.4500 * 1.0040 * 1.0067 * 0.9943;
ENDOKOEFF(R,PRDK,'VEDB') = ENDOKOEFF(R,PRDK,'VEDB') * 1.630436885 *  0.9736 * 0.9874 * 1.0274 * 1.2325 * 0.9987 * 1.0010;
ENDOKOEFF(R,PRDK,'VEDM') = ENDOKOEFF(R,PRDK,'VEDM') * 1.630436885 *  0.9736 * 0.9874 * 1.0274 * 1.2325 * 0.9987 * 1.0010;
ENDOKOEFF(R,PRDK,'AKST') = ENDOKOEFF(R,PRDK,'AKST') * 0.583751249 *  0.9905 * 0.9983 * 1.0158 * 1.2978 * 1.0208 * 0.9864;
ENDOKOEFF(R,PRDK,'KAPB') = ENDOKOEFF(R,PRDK,'KAPB') * 1.658542273 *  0.9458 * 0.9111 * 1.4406 * 0.9540  ;
ENDOKOEFF(R,PRDK,'KAPM') = ENDOKOEFF(R,PRDK,'KAPM') * 1.658542273 *  0.9458 * 0.9111 * 1.4406 * 0.9540  ;
*                                                                                                                                                                     * 
ENDOKOEFF(R,B,'ARBT')    = ENDOKOEFF(R,B,'ARBT')    * 1.427946411 *  0.9052 * 0.9910 * 0.8880 * 1.1094  ; 
ENDOKOEFF(R,B,'PLVR')    = ENDOKOEFF(R,B,'PLVR')    * 0.636459021 *  0.9891 * 0.9954 * 1.0506 * 1.0095  * 0.9949 * 0.9983; 
ENDOKOEFF(R,B,'VETM')    = ENDOKOEFF(R,B,'VETM')    * 1.721790088 *  1.0032 * 0.9919 * 0.4500 * 1.0040  * 1.0067 * 0.9943; 
ENDOKOEFF(R,B,'VEDB')    = ENDOKOEFF(R,B,'VEDB')    * 1.630436885 *  0.9736 * 0.9874 * 1.0274 * 1.2325  * 0.9987 * 1.0010; 
ENDOKOEFF(R,B,'VEDM')    = ENDOKOEFF(R,B,'VEDM')    * 1.630436885 *  0.9736 * 0.9874 * 1.0274 * 1.2325  * 0.9987 * 1.0010; 
ENDOKOEFF(R,B,'AKST')    = ENDOKOEFF(R,B,'AKST')    * 0.583751249 *  0.9905 * 0.9983 * 1.0158 * 1.2978  * 1.0208 * 0.9864; 
ENDOKOEFF(R,B,'KAPB')    = ENDOKOEFF(R,B,'KAPB')    * 1.658542273 *  0.9458 * 0.9111 * 1.4406 * 0.9540  ; 
ENDOKOEFF(R,B,'KAPM')    = ENDOKOEFF(R,B,'KAPM')    * 1.658542273 *  0.9458 * 0.9111 * 1.4406 * 0.9540  ;
*
*
* Input and farm-specific coefficients
Parameter FarmEndoKoeff(R,B,*,*);
FarmEndoKoeff(R,B,PRDK,DGVARE) = EndoKoeff(R,PRDK,DGVARE);
FarmEndoKoeff(R,B,'',DGVARE)   = EndoKoeff(R,B,DGVARE);

* BAKY
FarmEndoKoeff(R,'BAKY',PRDK,DGVARELIN) = FarmEndoKoeff(R,'BAKY',PRDK,DGVARELIN) * .5;
* 1: 113, 4: 117
FarmEndoKoeff(R,'BAKY','OKSS',DGVARE) $ (NOT SAMEAS('ARBT',DGVARE)) = FarmEndoKoeff(R,'BAKY','OKSS',DGVARE) * .1;
FarmEndoKoeff(R,'BAKY','KVGS',DGVARE) $ (NOT SAMEAS('ARBT',DGVARE)) = FarmEndoKoeff(R,'BAKY','KVGS',DGVARE) * .1;
FarmEndoKoeff(R,'BAKY','OKKS',DGVARE) $ (NOT SAMEAS('ARBT',DGVARE)) = FarmEndoKoeff(R,'BAKY','OKKS',DGVARE) * 1;
FarmEndoKoeff(R,'BAKY','KVKS',DGVARE) $ (NOT SAMEAS('ARBT',DGVARE)) = FarmEndoKoeff(R,'BAKY','KVKS',DGVARE) * 1;
*
*
FarmEndoKoeff(R,'BAKY',GROV,'ARBP')   = FarmEndoKoeff(R,'BAKY',GROV,'ARBP') * .25;
FarmEndoKoeff(R,'BAKY','AKYR','ARBP') = FarmEndoKoeff(R,'BAKY','AKYR','ARBP') * .25;
*
FarmEndoKoeff(R,'BSAU',GROV,DGVARE) $ (NOT (SAMEAS('ARBT',DGVARE) OR SAMEAS('ARBP',DGVARE))) = FarmEndoKoeff(R,'BSAU',GROV,DGVARE) / 10;
FarmEndoKoeff(R,'BAKY',GROV,'ARBT') = FarmEndoKoeff(R,'BAKY',GROV,'ARBT') * .25;
FarmEndoKoeff(R,'BSAU',GROV,'ARBT') = FarmEndoKoeff(R,'BSAU',GROV,'ARBT') * .15;
FarmEndoKoeff(R,'BGMK',GROV,'ARBT') = FarmEndoKoeff(R,'BGMK',GROV,'ARBT') * .15;
FarmEndoKoeff('12325B','BGMK',GROV,'ARBT') = FarmEndoKoeff('12325B','BGMK',GROV,'ARBT') * 2;
*
ENDOKOEFF(R,B,VARE)      $ ENDOKOEFF(R,B,VARE)      = ENDOKOEFF(R,B,VARE)       * (1 + KPI + INNSATVPRIS) ** (Y - %BAS%) ;
ENDOKOEFF(R,PRDK,DGVARE) $ ENDOKOEFF(R,PRDK,DGVARE) = ENDOKOEFF(R,PRDK,DGVARE)  * (1 + KPI + INNSATVPRIS) ** (Y - %BAS%) ;
FarmEndoKoeff(R,B,PRDK,DGVARE) $ FarmEndoKoeff(R,B,PRDK,DGVARE) = FarmEndoKoeff(R,B,PRDK,DGVARE)  * (1 + KPI + INNSATVPRIS) ** (Y - %BAS%) ;

*
Parameter EndokoeffTest(*,*,*,*,DGVARE);
EndokoeffTest('0',R,B,'',DGVARE)   = ENDOKOEFF(R,B,DGVARE)    ;
EndokoeffTest('0',R,'',PRDK,DGVARE) = ENDOKOEFF(R,PRDK,DGVARE) ;

*****************************
* Transform linear model into exponential model to mimic decreasing/increasing economies of scale
****************************
*
* 1. step: Calculate total factor use based on current coefficients and activity level of the linear model or exponential model if available
$ifThenI.Calib %PMP%== YES

* Load activity level from Precalibration run 
$ifThenI.PreCalib1 %PreCalibration%==NO
execute_load 'Tilbudsmodul\CalibLevl.gdx', CalibLevl;
CalibLevl(R,B,PRDK) $ (CalibLevl(R,B,PRDK) eq EPS) = 0;
$endIf.Precalib1

$ifThenI.PreCalib2 %PreCalibration%==YES
$include 'Tilbudsmodul\CalibLevlBackUp.gms'
$endif.PreCalib2

$endIf.Calib
*

$ifThenI.CalibSim %PMP%== NO
execute_load 'Tilbudsmodul\CalibLevl.gdx', CalibLevl;
CalibLevl(R,B,PRDK) $ (CalibLevl(R,B,PRDK) eq EPS) = 0;
$endIf.CalibSim


* 2. step: Define multiplicative term A of the exponential model Ax**E
Table EndoCoeffA_E(B,*)
       ARBP      ARBT       KAPT
BKRN   144.6500  4.5603     13.453
BHGE   50.6810   207.9529   310.5713
BFRK   53.013    298.3360   95.2027
BPTE   201.3600  461.4110   155.2622
BKMK   191.1     1189.5000  97.095
BGMK   99.4170   270.3456   197.8677
BAKY   5.0331    730.0400   293.4800
BSAU   3.9735    258.3800   48.3850
BGRI   48.7200   177.5380   166.3753
BHOE   205.2600  668.0525   1114.7918
BKYL   118.1500  59.2256    221.4574 
;

* Special treatment of capital for dairy farms in base year and simulation year due to loose barn housing regulation from 2034
$iftheni.LooseBarn %SIMYEAR%==NO
EndocoeffA_E('BKMK','KAPT') = 97.095;
$endif.LooseBarn
*
$iftheni.LooseBarn %SIMYEAR%==YES
EndocoeffA_E('BKMK','KAPT') = 460.22;
$endif.LooseBarn

Parameter EndoCoeffA(R,B,*,*);
EndoCoeffA(R,B,'','ARBP') = EndoCoeffA_E(B,'ARBP');
EndoCoeffA(R,B,'','ARBT') = EndoCoeffA_E(B,'ARBT');

* Split capital according to distribution according to ENDOKOEFF
EndoCoeffA(R,B,'','KAPB') = EndoCoeffA_E(B,'KAPT')
 * (ENDOKOEFF(R,B,'KAPB') + Sum(PRDK, ENDOKOEFF(R,PRDK,'KAPB') * CalibLevl(R,B,PRDK)))
 / (ENDOKOEFF(R,B,'KAPB') + ENDOKOEFF(R,B,'KAPM') + SUM(PRDK, (ENDOKOEFF(R,PRDK,'KAPB') + ENDOKOEFF(R,PRDK,'KAPM')) * CalibLevl(R,B,PRDK)));
*
EndoCoeffA(R,B,'','KAPM') = EndoCoeffA_E(B,'KAPT')
 * (ENDOKOEFF(R,B,'KAPM') + SUM(PRDK, ENDOKOEFF(R,PRDK,'KAPM') * CalibLevl(R,B,PRDK)))
 / (ENDOKOEFF(R,B,'KAPB') + ENDOKOEFF(R,B,'KAPM') + SUM(PRDK, (ENDOKOEFF(R,PRDK,'KAPB') + ENDOKOEFF(R,PRDK,'KAPM')) * CalibLevl(R,B,PRDK)));

* 3. step: Define exponent E of the exponential model Ax**E
Table EndoCoeffE(B,*)
       ARBT       ARBP     KAPT     VEDB    VEDM    PLVR    VETM    AKST
BKRN    -0.1510    0.0681  -0.1940  1       1       1       1       1
BHGE    -0.5000    0.2942  -0.5000  1       1       1       1       1
BFRK    -0.5000    0.4550  -0.5000  1       1       1       1       1
BPTE    -0.5000    0.1620  -0.5000  1       1       1       1       1
BKMK    -0.6670    0.0724   0.0613  1       1       1       1       1
BGMK    -0.5000    0.1998  -0.5000  1       1       1       1       1
BAKY    -0.6580    0.8378  -0.2880  1       1       1       1       1
BSAU    -0.5610    0.6219  -0.2820  1       1       1       1       1
BGRI    -0.3300    0.3460  -0.3300  1       1       1       1       1
BHOE    -0.3300    0.1968  -0.3300  1       1       1       1       1
BKYL    -0.3300    0.1064  -0.3300  1       1       1       1       1
;

* Special treatment of capital for dairy farms in base year and simulation year due to loose barn housing regulation from 2034
$iftheni.LooseBarn %SIMYEAR%==NO
EndocoeffE('BKMK','KAPT') = 0.0613;
$endif.LooseBarn
*
$iftheni.LooseBarn %SIMYEAR%==YES
EndocoeffE('BKMK','KAPT') = -0.271;
$endif.LooseBarn

EndoCoeffE(B,'KAPB') = EndoCoeffE(B,'KAPT') ;
EndoCoeffE(B,'KAPM') = EndoCoeffE(B,'KAPT') ;
 


Parameter EndoIntens(R,B,*) Estimated value ARBT_Timer ARBP_Kr per timer ;
EndoIntens(R,B,DGVARE) = SUM(PRDK $ B_TIL_HRDK(B,PRDK), CalibLevl(R,B,PRDK));


Parameter ShareEndoIntens(R,B,PRDK,*) Share PRDK ;

ShareEndoIntens(R,B,PRDK,DGVARE) $ (CalibLevl(R,B,PRDK) $ B_TIL_PRDK(PRDK,B) $ SUM(PRDKPRDK $ B_TIL_PRDK(PRDKPRDK,B), FarmEndoKoeff(R,B,PRDKPRDK,DGVARE) * CalibLevl(R,B,PRDKPRDK)))
 = (                                       FarmEndoKoeff(R,B,PRDK,DGVARE)     * CalibLevl(R,B,PRDK)
  / SUM(PRDKPRDK $ B_TIL_PRDK(PRDKPRDK,B), FarmEndoKoeff(R,B,PRDKPRDK,DGVARE) * CalibLevl(R,B,PRDKPRDK)) ) 
;

ShareEndoIntens(R,B,PRDK,DGVARE) $ (CalibLevl(R,B,PRDK) $ B_TIL_PRDK(PRDK,B) $ SUM(PRDKPRDK $ B_TIL_PRDK(PRDKPRDK,B), ShareEndoIntens(R,B,PRDKPRDK,DGVARE) * CalibLevl(R,B,PRDKPRDK)))
= ShareEndoIntens(R,B,PRDK,DGVARE)
 * SUM(PRDKPRDK $ B_TIL_HRDK(B,PRDKPRDK), CalibLevl(R,B,PRDKPRDK)) 
 / SUM(PRDKPRDK $ B_TIL_PRDK(PRDKPRDK,B), ShareEndoIntens(R,B,PRDKPRDK,DGVARE) * CalibLevl(R,B,PRDKPRDK))
;


EndokoeffTest('1','',B,'',DGVARE)   = EndoCoeffE(B,DGVARE)    ;
EndokoeffTest('1',R,B,PRDK,DGVARE)  = EndoCoeffA(R,B,PRDK,DGVARE) ;

* Calibrate multiplicative coefficient for all valid PRDK to estimated activity level
EndoCoeffA(R,B,PRDK,DGVARE) = 0;
EndoCoeffA(R,B,PRDK,DGVARE) $ B_TIL_HRDK(B,PRDK) = EndoCoeffA(R,B,'',DGVARE) / SUM(PRDKPRDK $ B_TIL_HRDK(B,PRDKPRDK), 1);

EndokoeffTest('2','',B,'',DGVARE)   = EndoCoeffE(B,DGVARE)    ;
EndokoeffTest('2',R,B,PRDK,DGVARE)  = EndoCoeffA(R,B,PRDK,DGVARE) ;

* Fill missing values for valid, non-optimal activities that exist for some farms in some regions
EndoCoeffA(R,B,PRDK,DGVARE) $ (B_TIL_PRDK(PRDK,B) $ Sum((RR,BB) $ EndoCoeffA(RR,BB,PRDK,DGVARE), 1) $ (NOT EndoCoeffA(R,B,PRDK,DGVARE))) = Sum((RR,BB), EndoCoeffA(RR,BB,PRDK,DGVARE)) / Sum((RR,BB) $ EndoCoeffA(RR,BB,PRDK,DGVARE), 1);              
*
* Fill missing values for valid, non-optimal activities that are totally missing
EndoCoeffA(R,B,'RAPM',DGVARE) = EndoCoeffA(R,B,'RAPF',DGVARE);
EndoCoeffA(R,B,'AKRM',DGVARE) = EndoCoeffA(R,B,'AKRF',DGVARE);
EndoCoeffA(R,B,'ERTM',DGVARE) = EndoCoeffA(R,B,'ERTF',DGVARE);

EndokoeffTest('3','',B,'',DGVARE)   = EndoCoeffE(B,DGVARE)    ;
EndokoeffTest('3',R,B,PRDK,DGVARE)  = EndoCoeffA(R,B,PRDK,DGVARE) ;

EndokoeffTest('EndoIntens0',R,B,'',DGVARE)   = EndoIntens(R,B,DGVARE)    ;
EndokoeffTest('EndoIntens1',R,B,'',DGVARE)   = SUM(PRDK $ (B_TIL_PRDK(PRDK,B) $ CalibLevl(R,B,PRDK)), ShareEndoIntens(R,B,PRDK,DGVARE) *  CalibLevl(R,B,PRDK)**EndoCoeffE(B,DGVARE))     ;

EndoCoeffA(R,B,'',DGVARE) = 0;    


EndokoeffTest('4','',B,'',DGVARE)   = EndoCoeffE(B,DGVARE)    ;
EndokoeffTest('4',R,B,PRDK,DGVARE)  = EndoCoeffA(R,B,PRDK,DGVARE) ;

EndokoeffTest('5',R,B,'',DGVARE) = 
     SUM(PRDK $ B_TIL_HRDK(B,PRDK), CalibLevl(R,B,PRDK)) 
  *  SUM(PRDK $ B_TIL_HRDK(B,PRDK), EndoCoeffA(R,B,PRDK,DGVARE)) 
  *  [SUM(PRDK $ (B_TIL_PRDK(PRDK,B) $ EndoCoeffE(B,DGVARE)), ShareEndoIntens(R,B,PRDK,DGVARE) * CalibLevl(R,B,PRDK))]**EndoCoeffE(B,DGVARE) 
;

* Final calibration of coefficients of the exponential model
Table CalibEndoCoeffA(B,*)
      KAPT      ARBT      ARBP 
BKRN   1.6882    0.8848    1 
BPTE   1.8669    0.2629    1 
BFRK   2.5293    0.8812    1 
BHGE   3.0299    0.6079    1 
BKMK   1.0949    0.9550    1 
BGMK   0.3177    0.3192    1 
BAKY   0.9160    0.6381    1 
BSAU   0.7112    0.6080    1  
BGRI   1.5000    2.5000    1   
BHOE   0.3188    0.6180    1 
BKYL   0.9000    0.9254    1 
;

CalibEndoCoeffA(B,'ARBT') = CalibEndoCoeffA(B,'ARBT') * 1.2669 * 0.9624 * 1.1094 * 0.9764 * 0.9833;
CalibEndoCoeffA(B,'KAPT') = CalibEndoCoeffA(B,'KAPT') * 1.5514 * 1.0033 * 0.9540 * 1.0102 * 0.9133 * 0.9840;
*
*
CalibEndoCoeffA(B,'KAPB') = CalibEndoCoeffA(B,'KAPT');
CalibEndoCoeffA(B,'KAPM') = CalibEndoCoeffA(B,'KAPT');

EndoCoeffA(R,B,PRDK,DGVARE)    $ B_TIL_HRDK(B,PRDK) = EndoCoeffA(R,B,PRDK,DGVARE)    $ B_TIL_HRDK(B,PRDK) * CalibEndoCoeffA(B,DGVARE);
*
*
$ifThenI.sim %SIMYEAR%==YES
* Adjustments in simulation year to counteract unreasonable economies of scale
ENDOKOEFF(R,'BPTE',VARE) $ ENDOKOEFF(R,'BPTE',VARE) = ENDOKOEFF(R,'BPTE',VARE)        * .75;
ENDOKOEFF(R,'POTE',DGVARE) $ ENDOKOEFF(R,'POTE',DGVARE) = ENDOKOEFF(R,'POTE',DGVARE)  * .75;
*
ENDOKOEFF(R,'BGMK',VARE) $ ENDOKOEFF(R,'BGMK',VARE) = ENDOKOEFF(R,'BGMK',VARE)        * 3;
ENDOKOEFF(R,'GEIT',DGVARE) $ ENDOKOEFF(R,'GEIT',DGVARE) = ENDOKOEFF(R,'GEIT',DGVARE)  * 3;
*
ENDOKOEFF(R,'BSAU',VARE) $ ENDOKOEFF(R,'BSAU',VARE) = ENDOKOEFF(R,'BSAU',VARE)        * 1.5;
ENDOKOEFF(R,'SOEY',DGVARE) $ ENDOKOEFF(R,'SOEY',DGVARE) = ENDOKOEFF(R,'SOEY',DGVARE)  * 1.5;
*
ENDOKOEFF(R,'BHGE',VARE) $ ENDOKOEFF(R,'BHGE',VARE) = ENDOKOEFF(R,'BHGE',VARE)  * 1.15;
ENDOKOEFF(R,GRNS,DGVARE) $ ENDOKOEFF(R,GRNS,DGVARE) = ENDOKOEFF(R,GRNS,DGVARE)  * 1.15;
*
ENDOKOEFF(R,'BKRN',VARE) $ ENDOKOEFF(R,'BKRN',VARE) = ENDOKOEFF(R,'BKRN',VARE)  * 1.2;
ENDOKOEFF(R,KORN,DGVARE) $ ENDOKOEFF(R,KORN,DGVARE) = ENDOKOEFF(R,KORN,DGVARE)  * 1.2;
$endif.sim

execute_unload 'tilbudsmodul\endokoeff.gdx', endokoeff FarmEndoKoeff dgkoeff enhdata endokoefftest brukstor endointens shareendointens endocoeffA EndoCoeffA_E endocoeffE caliblevl
*abort '';