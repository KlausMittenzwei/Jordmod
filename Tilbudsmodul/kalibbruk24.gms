************************************************************************
*
*   Jordmod-prosjekt 2005-2007
*
*   Ansvarlig: Klaus, NILF
*   Formaal: Kalibrering til basisaaret 2014
*   Kommentarer:
*   Status:
*
************************************************************************
*
SCALAR KORNOMFANGMAX Stoerrelse kornbruk
       FRBAOMFANGMAX Stoerrelse fruktbruk
       GRNSOMFANGMAX Stoerrelse groennsaksbruk
       KORNOMFANGMIN Stoerrelse kornbruk
       FRBAOMFANGMIN Stoerrelse fruktbruk
       GRNSOMFANGMIN Stoerrelse groennsaksbruk
;
**
PARAMETER
ENHKOST(R,B) Enhetskostnader for bruk og region pr hovedaktivitet
ENHKOSTTIL(RR,BB) Enhetskostnader korrigert for tilskudd
RESULTATDG(B,*,DG) Resultater pr hovedaktivitet og driftsgranskingsregion
RESTEXT(*,R,B) Resultater pr hovedaktivitet
;
************************************************************************
* Definisjon av intensitet i melkeproduksjonen
************************************************************************
* Parametrene er kalibrert til 1000 ltr melk og 1000 Fem
* Kilde: melk.gms
SCALARS
* current
AMELK  Grovfor melk /0.00542214/
BMELK  Kraftfor melk /0.00553475 /
CMELK  Linear del /0.24067  /
DMELK  Skalering FMELK /0.0541959/
EMELK  Substitusjon /1.18152/
FMELK  Tak meierileveranse /944.361/
MFGRV  Krav grovfor /1095.750/
MF     Krav for /1354.48/

* Standard: .45
KFORMAX max Kraftforprosent /.46/
KFORMIN min Kraftforprosent /.35/

FORMELK max sum for / 10000/
KALIBKMLK Kalibrering melkeytelse / 1.012 /
* Omregningsfaktor fra meierileveranse til bruttoproduksjon til utslippsberegning
ANDMEILEV Meierileveranse / 1.0497 /
;


* Test
*KFORMIN = KFORMAX;


*
* Scaling to meet requirements
MF = MF * 1.5;

* Timer per årsverk
Scalar TimerPerAarsverk / 1700 /;

*Parameter enhdatatest(R,VARE,AHUSDYR);
*enhdatatest(R,VARE,AHUSDYR) = enhdata(R,VARE,AHUSDYR,'BAS');
*Set enhdatatestset(R,AHUSDYR);
*enhdatatestset(R,AHUSDYR) $ ((ENHDATA(R,'FGRV',AHUSDYR,'BAS')+ENHDATA(R,'FDRM',AHUSDYR,'BAS')+ENHDATA(R,'FDRA',AHUSDYR,'BAS')) = 0) = YES;
*execute_unload 'enhdatatest.gdx', enhdatatest enhdatatestset;
*abort '';
*
PARAMETER MINKFORAHUSDYR(R,PRDK) Min andel kraftfor drovtyggere uten kumelk ;
MINKFORAHUSDYR(R,AHUSDYR) =
(ENHDATA(R,'FDRM',AHUSDYR,'BAS')+ENHDATA(R,'FDRA',AHUSDYR,'BAS'))/(ENHDATA(R,'FGRV',AHUSDYR,'BAS')+ENHDATA(R,'FDRM',AHUSDYR,'BAS')+ENHDATA(R,'FDRA',AHUSDYR,'BAS')) * .5;

PmpFeedQuad(R,B,VARE,PRDK) $ (AHUSDYR_TIL_MOEL(PRDK,VARE) AND (NOT SAMEAS('FFEM',VARE))) = .0;
PmpFeedCnst(R,B,VARE,PRDK) $ (AHUSDYR_TIL_MOEL(PRDK,VARE) AND (NOT SAMEAS('FFEM',VARE))) = .0;
$ontext

fra raadata\melk.gdx
CES-1095
a  0.00542214
b  0.00553475
c  0.24067
d  0.0541959
e  1.18152
f  944.361
mFGRV  1095.75
mF     1354.48


$offtext
*
* Teknisk framgang melk jf vekstrater.gms
* 0.01 (6952) til 0.1 (7041) til 0.5 (7442) til 0.25
KALIBKMLK = KALIBKMLK * (1 + TFMELK/100) ** (Y - %BAS%) ;
*
* Økt kraftfôrprosent
*display KFORMAX;
KFORMAX = KFORMAX * (1 + VEKSTMELK/100) ** (Y - %BAS%) ;
*abort KFORMAX;

*
*
Parameter GROVUpper(R) Upper bound for grovforandel per grovforaktivitet
          GROVLower(R) Lower bound for grovfôrandel per grovforaktivitet;
GrovUpper(R) = 1.01;
GrovLower(R) = .99;

* Grovforandel gras protein definert som maksimal absolutt grasareal
PARAMETER OMFGGFFP(R,B,PRDK);
OMFGGFFP(R,B,'GFFP') = 0;
*
PARAMETER GROVAND(R,PRDK,*) Min og maks andel grovfor i region;
GROVAND(R,GROV,'MAX') = (DATA(R,GROV,'OMFG','BAS') / SUM(GROVGROV, DATA(R,GROVGROV,'OMFG','BAS'))) * GrovUpper(R);
GROVAND(R,GROV,'MIN') = (DATA(R,GROV,'OMFG','BAS') / SUM(GROVGROV, DATA(R,GROVGROV,'OMFG','BAS'))) * GrovLower(R);
*
PARAMETER KORNAND(R,PRDK,*);
KORNAND(R,KORN,'MIN') $ (DATA(R,KORN,'OMFG','BAS') > .1) = (DATA(R,KORN,'OMFG','BAS') / SUM(KORNKORN$(DATA(R,KORNKORN,'OMFG','BAS') > .1), DATA(R,KORNKORN,'OMFG','BAS'))) * 0.975;
KORNAND(R,KORN,'MAX') $ (DATA(R,KORN,'OMFG','BAS') > .1) = (DATA(R,KORN,'OMFG','BAS') / SUM(KORNKORN$(DATA(R,KORNKORN,'OMFG','BAS') > .1), DATA(R,KORNKORN,'OMFG','BAS'))) * 1.025;

* Calibrate share bread grain
KORNAND(R,KORN,'MIN')  = KORNAND(R,KORN,'MIN')  * .9;
KORNAND(R,MATKN,'MAX') = KORNAND(R,MATKN,'MAX') * 1.5;

*
PARAMETER GRNSAND(R,PRDK,*);
GRNSAND(R,GRNS,'MIN') $ (DATA(R,GRNS,'OMFG','BAS') > .0000001) = (DATA(R,GRNS,'OMFG','BAS') / SUM(GRNSGRNS$(DATA(R,GRNSGRNS,'OMFG','BAS') > .0000001), DATA(R,GRNSGRNS,'OMFG','BAS'))) * 0.975;
GRNSAND(R,GRNS,'MAX') $ (DATA(R,GRNS,'OMFG','BAS') > .0000001) = (DATA(R,GRNS,'OMFG','BAS') / SUM(GRNSGRNS$(DATA(R,GRNSGRNS,'OMFG','BAS') > .0000001), DATA(R,GRNSGRNS,'OMFG','BAS'))) * 1.025;
*
PARAMETER FRBAAND(R,PRDK,*);
FRBAAND(R,FRBA,'MIN') $ (DATA(R,FRBA,'OMFG','BAS') > .0001) = (DATA(R,FRBA,'OMFG','BAS') / SUM(FRBAFRBA$(DATA(R,FRBAFRBA,'OMFG','BAS') > .0001), DATA(R,FRBAFRBA,'OMFG','BAS'))) * 0.975;
FRBAAND(R,FRBA,'MAX') $ (DATA(R,FRBA,'OMFG','BAS') > .0001) = (DATA(R,FRBA,'OMFG','BAS') / SUM(FRBAFRBA$(DATA(R,FRBAFRBA,'OMFG','BAS') > .0001), DATA(R,FRBAFRBA,'OMFG','BAS'))) * 1.025;
*
PARAMETER KALVAND(R,KALV,*);
KALVAND(R,KALV,'MIN') $ (DATA(R,KALV,'OMFG','BAS') > .0001) = (DATA(R,KALV,'OMFG','BAS') / (DATA(R,'MKYR','OMFG','BAS') + DATA(R,'AKYR','OMFG','BAS'))) * .9;
KALVAND(R,KALV,'MAX') $ (DATA(R,KALV,'OMFG','BAS') > .0001) = (DATA(R,KALV,'OMFG','BAS') / (DATA(R,'MKYR','OMFG','BAS') + DATA(R,'AKYR','OMFG','BAS'))) * 1.1;

execute_unload 'Tilbudsmodul\PRDKand.gdx', grovand, kornand, grnsand, frbaand, kalvand;
*abort '';



* Krav til overskudd av grovf�r i prosent
* 0: produksjon = behov
* 5: 5 prosent h�yere produksjon enn behov
SCALAR FGRVOverskd /10/ ;

* Kilde: SLF
PARAMETER BEITUKE(R) Minimum antall beiteuker;
BEITUKE(R) $ R_TIL_S('000001',R) = 12;
BEITUKE(R) $ R_TIL_S('000002',R) = 16;
BEITUKE(R) $ R_TIL_S('000003',R) = 16;
BEITUKE(R) $ R_TIL_S('000004',R) = 16;
BEITUKE(R) $ R_TIL_S('00005A',R) = 12;
BEITUKE(R) $ R_TIL_S('00005B',R) = 12;
BEITUKE(R) $ R_TIL_S('000006',R) = 12;
BEITUKE(R) $ R_TIL_S('000007',R) = 12;
*
* Kilde: KMI basert paa Ivar Hovland
PARAMETER VFORKRAV(R) Minimum antall uker med vinterfor;
VFORKRAV(R) $ R_TIL_DG('001100',R) = 52 - 20;
VFORKRAV(R) $ R_TIL_DG('001200',R) = 52 - 20;
VFORKRAV(R) $ R_TIL_DG('002100',R) = 52 - 30;
VFORKRAV(R) $ R_TIL_DG('002200',R) = 52 - 30;
VFORKRAV(R) $ R_TIL_DG('003200',R) = 52 - 20;
VFORKRAV(R) $ R_TIL_DG('004100',R) = 52 - 16;
VFORKRAV(R) $ R_TIL_DG('004200',R) = 52 - 16;
VFORKRAV(R) $ R_TIL_DG('005200',R) = 52 - 16;
*
* Kilde: Handbok for driftsplanlegging 4 daa pr GDE
* Antall dyr pr GDE
PARAMETER SPREDKOEFF(PRDK) Gjoedseldyreenhet  /
       MKYR   -1
       AKYR   -1.5
       OKSS   -3
       KVGS   -3
       KVGO   -3
       OKKS   -3
       KVKS   -3
       OKKO   -3
       KVKO   -3
       GRIS   -18
       PURK   -2.5
       SOEY   -7
       LAMS   -0
       GEIT   -7
       KJES   -0
       HOEN   -0.080
       KYLS   -1.400
/;

SPREDKOEFF(PLANTE) = GJODSELKRAV(PLANTE);
SPREDKOEFF('GFUB') = 0;
SPREDKOEFF('BRAK') = 0;

SPREDKOEFF(PRDK) $ SPREDKOEFF(PRDK) = 1/SPREDKOEFF(PRDK) ;
