ENDOKOEFF(R,'MKYR','KAPB')  = ENDOKOEFF(R,'MKYR','KAPB') * .3;
ENDOKOEFF(R,'BKMK','VETM')  = ENDOKOEFF(R,'BKMK','VETM') * .75;
ENDOKOEFF(R,'MKYR','VETM')  = ENDOKOEFF(R,'MKYR','VETM') * 2;
ENDOKOEFF(R,'MKYR','ARBT')  = ENDOKOEFF(R,'MKYR','ARBT') * .01;
ENDOKOEFF(R,'BKMK','ARBT')  = ENDOKOEFF(R,'BKMK','ARBT') *  2;
ENDOKOEFF(R,'MKYR','AKST')  = ENDOKOEFF(R,'MKYR','AKST') * 1;
ENDOKOEFF(R,'BKMK','AKST')  = ENDOKOEFF(R,'BKMK','AKST') * .6;
*
* BGMK
