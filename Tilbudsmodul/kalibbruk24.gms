*
* Change unreasonable numbers and calibrate
DGKOEFF('KNST12','KAPB') = -DGKOEFF('KNST12','KAPB') * .05;
DGKOEFF('KNST21','KAPB') = -DGKOEFF('KNST21','KAPB') * .01;
DGKOEFF('KNST22','KAPB') = -DGKOEFF('KNST22','KAPB') * .05;
DGKOEFF('KNST32','KAPB') = -DGKOEFF('KNST32','KAPB') * .05;
DGKOEFF('KNST41','KAPB') = -DGKOEFF('KNST41','KAPB') * .05;
DGKOEFF('KNST42','KAPB') = -DGKOEFF('KNST42','KAPB') * .05;
DGKOEFF('KNST52','KAPB') = -DGKOEFF('KNST52','KAPB') * .01;
DGKOEFF('GEIT','VETM')   = -DGKOEFF('GEIT','VETM') ;
*
* Remove constants for PLVR and VETM due to equation in supply module
DGKOEFF(B,'PLVR') = 0;
DGKOEFF('KNST','PLVR') = 0;
DGKOEFF('AREAL11','PLVR') = 0;
DGKOEFF('AREAL12','PLVR') = 0;
DGKOEFF('AREAL21','PLVR') = 0;
DGKOEFF('AREAL22','PLVR') = 0;
DGKOEFF('AREAL32','PLVR') = 0;
DGKOEFF('AREAL41','PLVR') = 0;
DGKOEFF('AREAL42','PLVR') = 0;
DGKOEFF('AREAL52','PLVR') = 0;
DGKOEFF(B,'VETM') = 0;
DGKOEFF('KNST','VETM') = 0;
DGKOEFF('AREAL11','VETM') = 0;
DGKOEFF('AREAL12','VETM') = 0;
DGKOEFF('AREAL21','VETM') = 0;
DGKOEFF('AREAL22','VETM') = 0;
DGKOEFF('AREAL32','VETM') = 0;
DGKOEFF('AREAL41','VETM') = 0;
DGKOEFF('AREAL42','VETM') = 0;
DGKOEFF('AREAL52','VETM') = 0;
*
* Calibrate constant term for capital
DGKOEFF('KNST','KAPB') = DGKOEFF('KNST','KAPB') * .05;
DGKOEFF('KNST','KAPM') = DGKOEFF('KNST','KAPM') * .05;
*
* Remove negative constants
DGKOEFF(B,DGVARE)        = MAX(0, DGKOEFF(B,DGVARE));
DGKOEFF('KNST',DGVARE)   = MAX(0, DGKOEFF('KNST',DGVARE));
DGKOEFF('KNST11',DGVARE) = MAX(0, DGKOEFF('KNST11',DGVARE));
DGKOEFF('KNST12',DGVARE) = MAX(0, DGKOEFF('KNST12',DGVARE));
DGKOEFF('KNST21',DGVARE) = MAX(0, DGKOEFF('KNST21',DGVARE));
DGKOEFF('KNST22',DGVARE) = MAX(0, DGKOEFF('KNST22',DGVARE));
DGKOEFF('KNST32',DGVARE) = MAX(0, DGKOEFF('KNST32',DGVARE));
DGKOEFF('KNST41',DGVARE) = MAX(0, DGKOEFF('KNST41',DGVARE));
DGKOEFF('KNST42',DGVARE) = MAX(0, DGKOEFF('KNST42',DGVARE));
DGKOEFF('KNST52',DGVARE) = MAX(0, DGKOEFF('KNST52',DGVARE));
*
* Calibrate UNGD for labour and capital
DGKOEFF('UNGD','ARBT') = 5;

DGKOEFF('UNGD','KAPB') = DGKOEFF('UNGD','KAPB') * .05;
DGKOEFF('UNGD','KAPM') = DGKOEFF('UNGD','KAPM') * .05;
*
ENDOKOEFF(R,PLANTE,DGVARE)$(R_TIL_DG('001100',R) $ (NOT SAMEAS('GFUB',PLANTE))) = DGKOEFF(PLANTE,DGVARE) ;
ENDOKOEFF(R,PLANTE,DGVARE)$(R_TIL_DG('001200',R) $ (NOT SAMEAS('GFUB',PLANTE))) = DGKOEFF(PLANTE,DGVARE) ;
ENDOKOEFF(R,PLANTE,DGVARE)$(R_TIL_DG('002100',R) $ (NOT SAMEAS('GFUB',PLANTE))) = DGKOEFF(PLANTE,DGVARE) ;
ENDOKOEFF(R,PLANTE,DGVARE)$(R_TIL_DG('002200',R) $ (NOT SAMEAS('GFUB',PLANTE))) = DGKOEFF(PLANTE,DGVARE) ;
ENDOKOEFF(R,PLANTE,DGVARE)$(R_TIL_DG('003200',R) $ (NOT SAMEAS('GFUB',PLANTE))) = DGKOEFF(PLANTE,DGVARE) ;
ENDOKOEFF(R,PLANTE,DGVARE)$(R_TIL_DG('004100',R) $ (NOT SAMEAS('GFUB',PLANTE))) = DGKOEFF(PLANTE,DGVARE) ;
ENDOKOEFF(R,PLANTE,DGVARE)$(R_TIL_DG('004200',R) $ (NOT SAMEAS('GFUB',PLANTE))) = DGKOEFF(PLANTE,DGVARE) ;
ENDOKOEFF(R,PLANTE,DGVARE)$(R_TIL_DG('005200',R) $ (NOT SAMEAS('GFUB',PLANTE))) = DGKOEFF(PLANTE,DGVARE) ;
*
ENDOKOEFF(R,GROV,DGVARE) = 0;
ENDOKOEFF(R,KORN,DGVARE) = 0;
*
ENDOKOEFF(R,KORN,DGVARE)$R_TIL_DG('001100',R) = DGKOEFF('KORN11',DGVARE) + DGKOEFF('KORN',DGVARE) ;
ENDOKOEFF(R,KORN,DGVARE)$R_TIL_DG('001200',R) = DGKOEFF('KORN12',DGVARE) + DGKOEFF('KORN',DGVARE) ;
ENDOKOEFF(R,KORN,DGVARE)$R_TIL_DG('002100',R) = DGKOEFF('KORN21',DGVARE) + DGKOEFF('KORN',DGVARE) ;
ENDOKOEFF(R,KORN,DGVARE)$R_TIL_DG('002200',R) = DGKOEFF('KORN22',DGVARE) + DGKOEFF('KORN',DGVARE) ;
ENDOKOEFF(R,KORN,DGVARE)$R_TIL_DG('003200',R) = DGKOEFF('KORN32',DGVARE) + DGKOEFF('KORN',DGVARE) ;
ENDOKOEFF(R,KORN,DGVARE)$R_TIL_DG('004100',R) = DGKOEFF('KORN41',DGVARE) + DGKOEFF('KORN',DGVARE) ;
ENDOKOEFF(R,KORN,DGVARE)$R_TIL_DG('004200',R) = DGKOEFF('KORN42',DGVARE) + DGKOEFF('KORN',DGVARE) ;
ENDOKOEFF(R,KORN,DGVARE)$R_TIL_DG('005200',R) = DGKOEFF('KORN52',DGVARE) + DGKOEFF('KORN',DGVARE) ;
*               
ENDOKOEFF(R,GROV,DGVARE)$R_TIL_DG('001100',R) = DGKOEFF('GROV11',DGVARE) ;
ENDOKOEFF(R,GROV,DGVARE)$R_TIL_DG('001200',R) = DGKOEFF('GROV12',DGVARE) ;
ENDOKOEFF(R,GROV,DGVARE)$R_TIL_DG('002100',R) = DGKOEFF('GROV21',DGVARE) ;
ENDOKOEFF(R,GROV,DGVARE)$R_TIL_DG('002200',R) = DGKOEFF('GROV22',DGVARE) ;
ENDOKOEFF(R,GROV,DGVARE)$R_TIL_DG('003200',R) = DGKOEFF('GROV32',DGVARE) ;
ENDOKOEFF(R,GROV,DGVARE)$R_TIL_DG('004100',R) = DGKOEFF('GROV41',DGVARE) ;
ENDOKOEFF(R,GROV,DGVARE)$R_TIL_DG('004200',R) = DGKOEFF('GROV42',DGVARE) ;
ENDOKOEFF(R,GROV,DGVARE)$R_TIL_DG('005200',R) = DGKOEFF('GROV52',DGVARE) ;
*
* Differentiate GROV
ENDOKOEFF(R,'GFFS',DGVARE) $ (NOT (SAMEAS('ARBT',DGVARE) OR SAMEAS('ARBP',DGVARE))) = ENDOKOEFF(R,'GFFS',DGVARE) * 1.2;
ENDOKOEFF(R,'GFFB',DGVARE) $ (NOT (SAMEAS('ARBT',DGVARE) OR SAMEAS('ARBP',DGVARE))) = ENDOKOEFF(R,'GFFB',DGVARE) * 1.1;
ENDOKOEFF(R,'GFOS',DGVARE) $ (NOT (SAMEAS('ARBT',DGVARE) OR SAMEAS('ARBP',DGVARE))) = ENDOKOEFF(R,'GFOS',DGVARE) * 1.;
ENDOKOEFF(R,'GFOB',DGVARE) $ (NOT (SAMEAS('ARBT',DGVARE) OR SAMEAS('ARBP',DGVARE))) = ENDOKOEFF(R,'GFOB',DGVARE) * .85;
ENDOKOEFF(R,'GFIB',DGVARE) $ (NOT (SAMEAS('ARBT',DGVARE) OR SAMEAS('ARBP',DGVARE))) = ENDOKOEFF(R,'GFIB',DGVARE) * .75;
*
* Calibrate GROV  
ENDOKOEFF(R,GROV,DGVARE) $ (NOT (SAMEAS('ARBT',DGVARE) OR SAMEAS('ARBP',DGVARE))) = ENDOKOEFF(R,GROV,DGVARE) * 1;
*
ENDOKOEFF(R,GROV,'ARBP') = ENDOKOEFF(R,GROV,'ARBP') * 3.5;
ENDOKOEFF(R,GROV,'ARBT') = ENDOKOEFF(R,GROV,'ARBT') * 5;


*
ENDOKOEFF('041203',GROV,DGVARE) = ENDOKOEFF('041203',GROV,DGVARE) * 1.;
ENDOKOEFF('04125A',GROV,DGVARE) = ENDOKOEFF('04125A',GROV,DGVARE) * 1.;
ENDOKOEFF('05125A',GROV,DGVARE) = ENDOKOEFF('05125A',GROV,DGVARE) * 1.;
ENDOKOEFF('05125A',GROV,DGVARE) = ENDOKOEFF('05125A',GROV,DGVARE) * 1.;
ENDOKOEFF('06125A',GROV,DGVARE) = ENDOKOEFF('06125A',GROV,DGVARE) * 1.;
ENDOKOEFF('081103',GROV,DGVARE) = ENDOKOEFF('081103',GROV,DGVARE) * 1.;
ENDOKOEFF('081203',GROV,DGVARE) = ENDOKOEFF('081203',GROV,DGVARE) * 1.;
ENDOKOEFF('08125A',GROV,DGVARE) = ENDOKOEFF('08125A',GROV,DGVARE) * 1.;
ENDOKOEFF('09225A',GROV,DGVARE) = ENDOKOEFF('09225A',GROV,DGVARE) * 1.;
ENDOKOEFF('112102',GROV,DGVARE) = ENDOKOEFF('112102',GROV,DGVARE) * .75;
ENDOKOEFF('11215B',GROV,DGVARE) = ENDOKOEFF('11215B',GROV,DGVARE) * .75;
ENDOKOEFF('11225B',GROV,DGVARE) = ENDOKOEFF('11225B',GROV,DGVARE) * 1.;
ENDOKOEFF('12325B',GROV,DGVARE) = ENDOKOEFF('12325B',GROV,DGVARE) * .8;
ENDOKOEFF('14325B',GROV,DGVARE) = ENDOKOEFF('14325B',GROV,DGVARE) * .8;
ENDOKOEFF('185206',GROV,DGVARE) = ENDOKOEFF('185206',GROV,DGVARE) * .9;
ENDOKOEFF('195206',GROV,DGVARE) = ENDOKOEFF('195206',GROV,DGVARE) * .9;
ENDOKOEFF('195207',GROV,DGVARE) = ENDOKOEFF('195207',GROV,DGVARE) * .9;
ENDOKOEFF('205207',GROV,DGVARE) = ENDOKOEFF('205207',GROV,DGVARE) * .9;
*
ENDOKOEFF(R,FRBA,DGVARE) = DGKOEFF('FRBA',DGVARE);
ENDOKOEFF(R,GRNS,DGVARE) = DGKOEFF('GRNS',DGVARE);
*
ENDOKOEFF(R,HUSDYR,DGVARE) = DGKOEFF(HUSDYR,DGVARE);
ENDOKOEFF(R,UNGD,DGVARE)   = DGKOEFF('UNGD',DGVARE) ;

*Differentiate UNGD
ENDOKOEFF(R,UNGD,'ARBT') = ENDOKOEFF(R,UNGD,'ARBT') * 1;
ENDOKOEFF(R,'OKSS',DGVARE) $ (NOT SAMEAS('ARBP',DGVARE)) = DGKOEFF('UNGD',DGVARE) * .15;
ENDOKOEFF(R,'KVGS',DGVARE) $ (NOT SAMEAS('ARBP',DGVARE)) = DGKOEFF('UNGD',DGVARE) * .15;
ENDOKOEFF(R,'KVGO',DGVARE) $ (NOT SAMEAS('ARBP',DGVARE)) = DGKOEFF('UNGD',DGVARE) * 1;
* 3: fra 2 til 1.5
ENDOKOEFF(R,'OKKS',DGVARE) $ (NOT SAMEAS('ARBP',DGVARE)) = DGKOEFF('UNGD',DGVARE) * 1.5;
ENDOKOEFF(R,'KVKS',DGVARE) $ (NOT SAMEAS('ARBP',DGVARE)) = DGKOEFF('UNGD',DGVARE) * 1.5;
ENDOKOEFF(R,'OKKO',DGVARE) $ (NOT SAMEAS('ARBP',DGVARE)) = DGKOEFF('UNGD',DGVARE) * .25 ;
ENDOKOEFF(R,'KVKO',DGVARE) $ (NOT SAMEAS('ARBP',DGVARE)) = DGKOEFF('UNGD',DGVARE) * .25 ;
ENDOKOEFF(R,UNGD,'ARBP') = 1;
*
ENDOKOEFF(R,B,DGVARE)$R_TIL_DG('001100',R) = DGKOEFF('KNST',DGVARE) + DGKOEFF('KNST11',DGVARE) + DGKOEFF(B,DGVARE) + DGKOEFF('AREAL11',DGVARE);
ENDOKOEFF(R,B,DGVARE)$R_TIL_DG('001200',R) = DGKOEFF('KNST',DGVARE) + DGKOEFF('KNST12',DGVARE) + DGKOEFF(B,DGVARE) + DGKOEFF('AREAL12',DGVARE);
ENDOKOEFF(R,B,DGVARE)$R_TIL_DG('002100',R) = DGKOEFF('KNST',DGVARE) + DGKOEFF('KNST21',DGVARE) + DGKOEFF(B,DGVARE) + DGKOEFF('AREAL21',DGVARE);
ENDOKOEFF(R,B,DGVARE)$R_TIL_DG('002200',R) = DGKOEFF('KNST',DGVARE) + DGKOEFF('KNST22',DGVARE) + DGKOEFF(B,DGVARE) + DGKOEFF('AREAL22',DGVARE);
ENDOKOEFF(R,B,DGVARE)$R_TIL_DG('003200',R) = DGKOEFF('KNST',DGVARE) + DGKOEFF('KNST32',DGVARE) + DGKOEFF(B,DGVARE) + DGKOEFF('AREAL32',DGVARE);
ENDOKOEFF(R,B,DGVARE)$R_TIL_DG('004100',R) = DGKOEFF('KNST',DGVARE) + DGKOEFF('KNST41',DGVARE) + DGKOEFF(B,DGVARE) + DGKOEFF('AREAL41',DGVARE);
ENDOKOEFF(R,B,DGVARE)$R_TIL_DG('004200',R) = DGKOEFF('KNST',DGVARE) + DGKOEFF('KNST42',DGVARE) + DGKOEFF(B,DGVARE) + DGKOEFF('AREAL42',DGVARE);
ENDOKOEFF(R,B,DGVARE)$R_TIL_DG('005200',R) = DGKOEFF('KNST',DGVARE) + DGKOEFF('KNST52',DGVARE) + DGKOEFF(B,DGVARE) + DGKOEFF('AREAL52',DGVARE);
*
ENDOKOEFF(R,B,'GROV') = 0;
ENDOKOEFF(R,B,'KORN') = 0;
ENDOKOEFF(R,B,'UNGD') = 0;
ENDOKOEFF(R,B,'FRBA') = 0;
ENDOKOEFF(R,B,'GRNS') = 0;
*
* General scaling
ENDOKOEFF(R,PRDK,'ARBP')  = ENDOKOEFF(R,PRDK,'ARBP') * 1000   ;
*

* Farm-specific scaling
* BKRN
ENDOKOEFF(R,KORN,'ARBT') $ R_TIL_DG('002100',R) = .75;
ENDOKOEFF(R,KORN,'ARBT') $ R_TIL_DG('005200',R) = 1.;
ENDOKOEFF(R,'BKRN','ARBT')  = ENDOKOEFF(R,'BKRN','ARBT') * .35;
ENDOKOEFF(R,KORN,'ARBT')    = ENDOKOEFF(R,KORN,'ARBT')   * .5;
ENDOKOEFF(R,KORN,'ARBP')    = ENDOKOEFF(R,KORN,'ARBP')   * 1;
ENDOKOEFF(R,'BKRN','ARBP')  = -10000;
ENDOKOEFF(R,'BKRN','VEDB')  = ENDOKOEFF(R,'BKRN','VEDB') * .05;
ENDOKOEFF(R,KORN,'VEDB')    = ENDOKOEFF(R,KORN,'VEDB')   * .05;
ENDOKOEFF(R,'BKRN','VEDM')  = ENDOKOEFF(R,'BKRN','VEDM') * .1;
ENDOKOEFF(R,KORN,'VEDM')    = ENDOKOEFF(R,KORN,'VEDM')   * .1;
ENDOKOEFF(R,KORN,'AKST')    = ENDOKOEFF(R,KORN,'AKST')   * .75;
ENDOKOEFF(R,'BKRN','PLVR')  = ENDOKOEFF(R,'BKRN','PLVR') * .25;
ENDOKOEFF(R,KORN,'PLVR')    = ENDOKOEFF(R,KORN,'PLVR')   * 1;
ENDOKOEFF(R,'BKRN','KAPB')  = ENDOKOEFF(R,'BKRN','KAPB') * 1;
ENDOKOEFF(R,KORN,'KAPB')    = ENDOKOEFF(R,KORN,'KAPB')   * 1;
ENDOKOEFF(R,'BKRN','KAPM')  = ENDOKOEFF(R,'BKRN','KAPM') * 1;
ENDOKOEFF(R,KORN,'KAPM')    = ENDOKOEFF(R,KORN,'KAPM')   * 1;
ENDOKOEFF(R,'BKRN','AKST')  = ENDOKOEFF(R,'BKRN','AKST') * .75;
ENDOKOEFF(R,KORN,'AKST')    = ENDOKOEFF(R,KORN,'AKST')   * .75;
*ENDOKOEFF(R,'BKRN','PLVR')  = MAX(1, ENDOKOEFF(R,'BKRN','PLVR'));
*
* BPTE
ENDOKOEFF(R,'BPTE','ARBP')  = -5000;
ENDOKOEFF(R,'POTE','ARBP')  = ENDOKOEFF(R,'POTE','ARBP') * 2;
ENDOKOEFF(R,'BPTE','PLVR')  = ENDOKOEFF(R,'BPTE','PLVR') * .1;
ENDOKOEFF(R,'POTE','PLVR')  = ENDOKOEFF(R,'POTE','PLVR') * 2;
ENDOKOEFF(R,'BPTE','ARBT')  = ENDOKOEFF(R,'POTE','ARBT') * 1.;
ENDOKOEFF(R,'POTE','ARBT')  = ENDOKOEFF(R,'POTE','ARBT') * 2.;
ENDOKOEFF(R,'BPTE','VEDB')  = ENDOKOEFF(R,'BPTE','VEDB') * .25;
ENDOKOEFF(R,'POTE','VEDB')  = ENDOKOEFF(R,'POTE','VEDB') * .5;
ENDOKOEFF(R,'BPTE','VEDM')  = ENDOKOEFF(R,'BPTE','VEDM') * .25;
ENDOKOEFF(R,'POTE','VEDM')  = ENDOKOEFF(R,'POTE','VEDM') * .5;
ENDOKOEFF(R,'POTE','AKST')  = ENDOKOEFF(R,'POTE','AKST') * .75;
ENDOKOEFF(R,'POTE','PLVR')  = ENDOKOEFF(R,'POTE','PLVR') * 1;
ENDOKOEFF(R,'BPTE','KAPB')  = ENDOKOEFF(R,'BPTE','KAPB') * .6;
ENDOKOEFF(R,'POTE','KAPB')  = ENDOKOEFF(R,'POTE','KAPB') * .6;
ENDOKOEFF(R,'BPTE','KAPM')  = ENDOKOEFF(R,'BPTE','KAPM') * .6;
ENDOKOEFF(R,'POTE','KAPM')  = ENDOKOEFF(R,'POTE','KAPM') * .6;
ENDOKOEFF(R,'POTE','AKST')  = ENDOKOEFF(R,'POTE','AKST') * 1;
*
* BFRK
ENDOKOEFF(R,FRBA,'ARBP')  = ENDOKOEFF(R,FRBA,'ARBP') * 5;
ENDOKOEFF(R,'BFRK','ARBP')  = -250000;
ENDOKOEFF(R,'BFRK','ARBT')  = ENDOKOEFF(R,'BFRK','ARBT') * .33;
ENDOKOEFF(R,FRBA,'ARBT')  = ENDOKOEFF(R,FRBA,'ARBT') * 1.1;
ENDOKOEFF(R,FRBA,'VEDM')  = ENDOKOEFF(R,FRBA,'VEDM') * 6;
ENDOKOEFF(R,FRBA,'VEDB')  = ENDOKOEFF(R,FRBA,'VEDB') * 6;
ENDOKOEFF(R,FRBA,'AKST')  = ENDOKOEFF(R,FRBA,'AKST') * 10;
ENDOKOEFF(R,FRBA,'PLVR')  = ENDOKOEFF(R,FRBA,'PLVR') * 10;
ENDOKOEFF(R,FRBA,'KAPB')  = ENDOKOEFF(R,FRBA,'KAPB') * 2;
ENDOKOEFF(R,FRBA,'KAPM')  = ENDOKOEFF(R,FRBA,'KAPM') * 2;
ENDOKOEFF(R,'BFRK','KAPB')= ENDOKOEFF(R,'BFRK','KAPB') * .25;
ENDOKOEFF(R,'BFRK','KAPM')= ENDOKOEFF(R,'BFRK','KAPM') * .25;
*
* BHGE
ENDOKOEFF(R,'BHGE','ARBP')  = -250000  ;
ENDOKOEFF(R,GRNS,'ARBP')    = ENDOKOEFF(R,GRNS,'ARBP') * 3;
ENDOKOEFF(R,'BHGE','ARBT')  = ENDOKOEFF(R,'BHGE','ARBT') * .075  ;
ENDOKOEFF(R,GRNS,'ARBT')    = ENDOKOEFF(R,GRNS,'ARBT') * .075  ;
