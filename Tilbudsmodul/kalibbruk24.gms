ENDOKOEFF(R,GRNS,'KAPM')    = ENDOKOEFF(R,GRNS,'KAPM') * .01;
ENDOKOEFF(R,'BHGE','KAPB')    = ENDOKOEFF(R,'BHGE','KAPB') * .01;
ENDOKOEFF(R,'BHGE','KAPM')    = ENDOKOEFF(R,'BHGE','KAPM') * .01;
*
* BKMK
ENDOKOEFF(R,'MKYR','ARBP')  = ENDOKOEFF(R,'MKYR','ARBP') * .5;
