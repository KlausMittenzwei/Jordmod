************************************************************************
*
*   Jordmod-prosjekt 2005-2007
*
*   Ansvarlig: Klaus, NILF
*   Formaal: Nonimell framskriving av alle satser i forhold til KPI
*   Kommentarer: Brukes i beregningene for referansebane Hoeyres jordbrukspolitikk
*   Status:
*
************************************************************************
* Nominell framskriving av alle satser med KPI
SCALAR TKPI Andel av KPI som tilskuddssatser fremskrives med / 0 /;

SATSER(TILSKUDD,VARE,TTIL,R)     =  SATSER(TILSKUDD,VARE,TTIL,R)      * (1 + (KPI * TKPI)) ** (Y - %BAS%) ;
SATSER(TILSKUDD,VARE,TTIL,'0')   =  SATSER(TILSKUDD,VARE,TTIL,'0')    * (1 + (KPI * TKPI)) ** (Y - %BAS%);
*
SATSER(TILSKUDD,PRDK,TTIL,R)     =  SATSER(TILSKUDD,PRDK,TTIL,R)      * (1 + (KPI * TKPI)) ** (Y - %BAS%);
SATSER(TILSKUDD,PRDK,TTIL,'0')   =  SATSER(TILSKUDD,PRDK,TTIL,'0')    * (1 + (KPI * TKPI)) ** (Y - %BAS%);

SATSER(TILSKUDD,'UNGD',TTIL,R)   =  SATSER(TILSKUDD,'UNGD',TTIL,R)    * (1 + (KPI * TKPI)) ** (Y - %BAS%) ;
SATSER(TILSKUDD,'UNGD',TTIL,'0') =  SATSER(TILSKUDD,'UNGD',TTIL,'0')  * (1 + (KPI * TKPI)) ** (Y - %BAS%) ;
*
SATSER(TILSKUDD,'KORN',TTIL,R)   =  SATSER(TILSKUDD,'KORN',TTIL,R)    * (1 + (KPI * TKPI)) ** (Y - %BAS%);
SATSER(TILSKUDD,'KORN',TTIL,'0') =  SATSER(TILSKUDD,'KORN',TTIL,'0')  * (1 + (KPI * TKPI)) ** (Y - %BAS%);
*
SATSER(TILSKUDD,'GROV',TTIL,R)   =  SATSER(TILSKUDD,'GROV',TTIL,R)    * (1 + (KPI * TKPI)) ** (Y - %BAS%) ;
SATSER(TILSKUDD,'GROV',TTIL,'0') =  SATSER(TILSKUDD,'GROV',TTIL,'0')  * (1 + (KPI * TKPI)) ** (Y - %BAS%) ;
*
SATSER(TILSKUDD,'ARBF',TTIL,R)   =  SATSER(TILSKUDD,'ARBF',TTIL,R)    * (1 + (KPI * TKPI)) ** (Y - %BAS%) ;
SATSER(TILSKUDD,'ARBF',TTIL,'0') =  SATSER(TILSKUDD,'ARBF',TTIL,'0')  * (1 + (KPI * TKPI)) ** (Y - %BAS%) ;
*
MAKSSATS(TILSKUDD)    = MAKSSATS(TILSKUDD)    * (1 + (KPI * TKPI)) ** (Y - %BAS%);
BUNNFRADRAG(TILSKUDD) = BUNNFRADRAG(TILSKUDD) * (1 + (KPI * TKPI)) ** (Y - %BAS%);

SCALAR TILJUST / 1 /;

SATSER(TILSKUDD,VARE,TTIL,R)     =  SATSER(TILSKUDD,VARE,TTIL,R)      * TILJUST;
SATSER(TILSKUDD,VARE,TTIL,'0')   =  SATSER(TILSKUDD,VARE,TTIL,'0')    * TILJUST;
*
SATSER(TILSKUDD,PRDK,TTIL,R)     =  SATSER(TILSKUDD,PRDK,TTIL,R)      * TILJUST;
SATSER(TILSKUDD,PRDK,TTIL,'0')   =  SATSER(TILSKUDD,PRDK,TTIL,'0')    * TILJUST;

SATSER(TILSKUDD,'KORN',TTIL,R)   =  SATSER(TILSKUDD,'KORN',TTIL,R)    * TILJUST ;
SATSER(TILSKUDD,'KORN',TTIL,'0') =  SATSER(TILSKUDD,'KORN',TTIL,'0')  * TILJUST ;
*
SATSER(TILSKUDD,'UNGD',TTIL,R)   =  SATSER(TILSKUDD,'UNGD',TTIL,R)    * TILJUST;
SATSER(TILSKUDD,'UNGD',TTIL,'0') =  SATSER(TILSKUDD,'UNGD',TTIL,'0')  * TILJUST;

SATSER(TILSKUDD,'ARBF',TTIL,R)   =  SATSER(TILSKUDD,'ARBF',TTIL,R)    * TILJUST;
SATSER(TILSKUDD,'ARBF',TTIL,'0') =  SATSER(TILSKUDD,'ARBF',TTIL,'0')  * TILJUST;
*
SATSER(TILSKUDD,'KORN',TTIL,R)   =  SATSER(TILSKUDD,'KORN',TTIL,R)    * 1;
SATSER(TILSKUDD,'KORN',TTIL,'0') =  SATSER(TILSKUDD,'KORN',TTIL,'0')  * 1;
*
SATSER(TILSKUDD,'KORN',TTIL,R)  $ R_TIL_F('010000',R) =  SATSER(TILSKUDD,'KORN',TTIL,R) * 1.0;
SATSER(TILSKUDD,'KORN',TTIL,R)  $ R_TIL_F('020300',R) =  SATSER(TILSKUDD,'KORN',TTIL,R) * 1.0;
SATSER(TILSKUDD,'KORN',TTIL,R)  $ R_TIL_F('040000',R) =  SATSER(TILSKUDD,'KORN',TTIL,R) * 1.0;
SATSER(TILSKUDD,'KORN',TTIL,R)  $ R_TIL_F('050000',R) =  SATSER(TILSKUDD,'KORN',TTIL,R) * 1.0;
SATSER(TILSKUDD,'KORN',TTIL,R)  $ R_TIL_F('160000',R) =  SATSER(TILSKUDD,'KORN',TTIL,R) * 1.0;
SATSER(TILSKUDD,'KORN',TTIL,R)  $ R_TIL_F('170000',R) =  SATSER(TILSKUDD,'KORN',TTIL,R) * 1.0;
*
* fra 0 (191) til 0.5 
*SATSER('TGRUN',DemKorn,'0','0')   =  SATSER('TGRUN',DemKorn,'0','0') + 0.5/1000;
* 
*SATSER(TILSKUDD,'POTE',TTIL,R)   =  SATSER(TILSKUDD,'POTE',TTIL,R)    * 2.5;
*SATSER(TILSKUDD,'POTE',TTIL,'0') =  SATSER(TILSKUDD,'POTE',TTIL,'0')  * 2.5;
*
*SATSER('TGRUN',DemHage,'0','0')   =  SATSER('TGRUN',DemHage,'0','0') + 1/1000;
*
*SATSER(TILSKUDD,FRBA,TTIL,R)   =  SATSER(TILSKUDD,FRBA,TTIL,R)    * 2.0;
*SATSER(TILSKUDD,FRBA,TTIL,'0') =  SATSER(TILSKUDD,FRBA,TTIL,'0')  * 2.0;
*
*SATSER(TILSKUDD,GRNS,TTIL,R)   =  SATSER(TILSKUDD,GRNS,TTIL,R)    * 2.0;
*SATSER(TILSKUDD,GRNS,TTIL,'0') =  SATSER(TILSKUDD,GRNS,TTIL,'0')  * 2.0;
*
*SATSER(TILSKUDD,'GAKF',TTIL,R)   =  SATSER(TILSKUDD,'GAKF',TTIL,R)    * 1.25;
*SATSER(TILSKUDD,'GAKF',TTIL,'0') =  SATSER(TILSKUDD,'GAKF',TTIL,'0')  * 1.25;
*                                                                         
*SATSER(TILSKUDD,'GAKR',TTIL,R)   =  SATSER(TILSKUDD,'GAKR',TTIL,R)    * 1.25;
*SATSER(TILSKUDD,'GAKR',TTIL,'0') =  SATSER(TILSKUDD,'GAKR',TTIL,'0')  * 1.25;
*
* fra 1.5 (575) til 1.75
*SATSER(TILSKUDD,'SOEY',TTIL,R)  $ R_TIL_SD('000100',R) =  SATSER(TILSKUDD,'SOEY',TTIL,R)    * 1.75;
*SATSER(TILSKUDD,'SOEY',TTIL,R)  $ R_TIL_SD('000200',R) =  SATSER(TILSKUDD,'SOEY',TTIL,R)    * 1.75;
*SATSER(TILSKUDD,'SOEY',TTIL,'0')                       =  SATSER(TILSKUDD,'SOEY',TTIL,'0')  * 1.75;
*                                                                                             
*SATSER(TILSKUDD,'LAMS',TTIL,R)  $ R_TIL_SD('000100',R) =  SATSER(TILSKUDD,'LAMS',TTIL,R)    * 1.75;
*SATSER(TILSKUDD,'LAMS',TTIL,R)  $ R_TIL_SD('000200',R) =  SATSER(TILSKUDD,'LAMS',TTIL,R)    * 1.75;
*SATSER(TILSKUDD,'LAMS',TTIL,'0')                       =  SATSER(TILSKUDD,'LAMS',TTIL,'0')  * 1.75;
*
*SATSER('TGRUN','SAUK',TTIL,R)  $ R_TIL_DG('004100',R) =  SATSER('TGRUN','SAUK',TTIL,R) + 0;
*SATSER('TGRUN','SAUK',TTIL,R)  $ R_TIL_DG('004200',R) =  SATSER('TGRUN','SAUK',TTIL,R) + 0;
*SATSER('TGRUN','SAUK',TTIL,R)  $ R_TIL_DG('005200',R) =  SATSER('TGRUN','SAUK',TTIL,R) + 0;
*
*SATSER('TGRUN','KMLK','0','0')   =  SATSER('TGRUN','KMLK','0','0') + 0.5/1000;
*SATSER(TILSKUDD,'MKYR',TTIL,R)   =  SATSER(TILSKUDD,'MKYR',TTIL,R)    * 1;
*SATSER(TILSKUDD,'MKYR',TTIL,'0') =  SATSER(TILSKUDD,'MKYR',TTIL,'0')  * 1;
*SATSER(TILSKUDD,'MKYR',TTIL,R)   $ R_TIL_SD('000200',R) =  SATSER(TILSKUDD,'MKYR',TTIL,R)    * 1.5;
*
*SATSER('TGRUN','GMLK','0','0')   =  SATSER('TGRUN','GMLK','0','0') + 1/1000;
*SATSER(TILSKUDD,'GEIT',TTIL,R)   =  SATSER(TILSKUDD,'GEIT',TTIL,R)    * 2;
*SATSER(TILSKUDD,'GEIT',TTIL,'0') =  SATSER(TILSKUDD,'GEIT',TTIL,'0')  * 2;
*SATSER(TILSKUDD,'GEIT',TTIL,R)   $ R_TIL_SD('000200',R) =  SATSER(TILSKUDD,'GEIT',TTIL,R)    * 5;
*
* fra 1.5 (129) til 1.25
*SATSER(TILSKUDD,'AKYR',TTIL,'0')                      =  SATSER(TILSKUDD,'AKYR',TTIL,'0')  * 1.1;
*SATSER(TILSKUDD,'AKYR',TTIL,R)                        =  SATSER(TILSKUDD,'AKYR',TTIL,R)    * 1.1;
*SATSER(TILSKUDD,'AKYR',TTIL,R)   $ R_TIL_SD('000100',R) =  SATSER(TILSKUDD,'AKYR',TTIL,R)    * 1.;
*SATSER(TILSKUDD,'AKYR',TTIL,R)   $ R_TIL_SD('000200',R) =  SATSER(TILSKUDD,'AKYR',TTIL,R)    * 1.5;
*
* fra 1.25 til 1.5
*SATSER(TILSKUDD,'UNGD',TTIL,'0') =  SATSER(TILSKUDD,'UNGD',TTIL,'0') * 1.0;
*SATSER(TILSKUDD,'UNGD',TTIL,R)   =  SATSER(TILSKUDD,'UNGD',TTIL,R)   * 1.0;
*SATSER(TILSKUDD,'UNGD',TTIL,R)   $ R_TIL_SD('000100',R) =  SATSER(TILSKUDD,'UNGD',TTIL,R)    * 1.0;
*SATSER(TILSKUDD,'UNGD',TTIL,R)   $ R_TIL_SD('000200',R) =  SATSER(TILSKUDD,'UNGD',TTIL,R)    * 1.0;
*
*SATSER(TILSKUDD,'KYLS',TTIL,R)   =  SATSER(TILSKUDD,'KYLS',TTIL,R)    * 1;
*SATSER(TILSKUDD,'KYLS',TTIL,'0') =  SATSER(TILSKUDD,'KYLS',TTIL,'0')  * 1;
*
*SATSER(TILSKUDD,'PURK',TTIL,R)   =  SATSER(TILSKUDD,'PURK',TTIL,R)    * 1.25;
*SATSER(TILSKUDD,'PURK',TTIL,'0') =  SATSER(TILSKUDD,'PURK',TTIL,'0')  * 1.25;
*
*SATSER(TILSKUDD,'GRIS',TTIL,R)   =  SATSER(TILSKUDD,'GRIS',TTIL,R)    * 1.25;
*SATSER(TILSKUDD,'GRIS',TTIL,'0') =  SATSER(TILSKUDD,'GRIS',TTIL,'0')  * 1.25;
*
*SATSER(TILSKUDD,'HOEN',TTIL,R)   =  SATSER(TILSKUDD,'HOEN',TTIL,R)    * 1.5;
*SATSER(TILSKUDD,'HOEN',TTIL,'0') =  SATSER(TILSKUDD,'HOEN',TTIL,'0')  * 1.5;
*
execute_unload 'resultater\satser%SCEN%.gdx', satser;



