SET I /I1*I5/;

PARAMETER RESULTAT(SCEN,INDEX1,INDEX2,INDEX3);
PARAMETER KONVERGENS(INDEX1,INDEX2,INDEX3,I);
PARAMETER INDIKATORRES(INDEX1,INDEX2,INDEX3,SCEN);
PARAMETER INDIKATORPOL(INDEX1,INDEX2,INDEX3,SCEN);
PARAMETER INDIKATORKONV(INDEX1,INDEX2,INDEX3,I,SCEN);
PARAMETER INDIKATORSATS(INDEX0,INDEX1,INDEX2,INDEX3,SCEN);
PARAMETER INDIKATORAssum(INDEX0,INDEX1,INDEX2,INDEX3,SCEN);
PARAMETER POL(INDEX1,INDEX2,INDEX3);
PARAMETER Satser(INDEX0,INDEX1,INDEX2,INDEX3);
PARAMETER Assum(INDEX0,INDEX1,INDEX2,INDEX3);

PARAMETER CalibINDIKATORRES(INDEX1,INDEX2,INDEX3,*);
PARAMETER CalibINDIKATORPOL(INDEX1,INDEX2,INDEX3,*);
PARAMETER CalibINDIKATORKONV(INDEX1,INDEX2,INDEX3,I,*);
PARAMETER CalibINDIKATORSATS(INDEX0,INDEX1,INDEX2,INDEX3,*);

*$onText
execute_load 'resultater\Calib.gdx' Resultat;
CalibINDIKATORRES(INDEX1,INDEX2,INDEX3,'Calib') = RESULTAT('BAS',INDEX1,INDEX2,INDEX3);
execute_load 'resultater\Calib_KONV.gdx' Konvergens;
CalibINDIKATORKONV(INDEX1,INDEX2,INDEX3,I,'Calib') = KONVERGENS(INDEX1,INDEX2,INDEX3,I);
execute_load 'resultater\satserCalib.gdx' Satser;
CalibINDIKATORSATS(INDEX0,INDEX1,INDEX2,INDEX3,'Calib') = Satser(INDEX0,INDEX1,INDEX2,INDEX3);
execute_load 'resultater\Calib_POL.gdx' Pol;
CalibINDIKATORPOL(INDEX1,INDEX2,INDEX3,'Calib') = Pol(INDEX1,INDEX2,INDEX3);
*$offText

execute_load 'resultater\BAS.gdx' Resultat;
INDIKATORRES(INDEX1,INDEX2,INDEX3,'BAS') = RESULTAT('BAS',INDEX1,INDEX2,INDEX3);
execute_load 'resultater\BAS_KONV.gdx' Konvergens;
INDIKATORKONV(INDEX1,INDEX2,INDEX3,I,'BAS') = KONVERGENS(INDEX1,INDEX2,INDEX3,I);
execute_load 'resultater\satserBAS.gdx' Satser;
INDIKATORSATS(INDEX0,INDEX1,INDEX2,INDEX3,'BAS') = Satser(INDEX0,INDEX1,INDEX2,INDEX3);
execute_load 'resultater\BAS_POL.gdx' Pol;
INDIKATORPOL(INDEX1,INDEX2,INDEX3,'BAS') = Pol(INDEX1,INDEX2,INDEX3);
*
execute_load 'resultater\REF.gdx' Resultat;
