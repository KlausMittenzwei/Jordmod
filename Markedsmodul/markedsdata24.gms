Parameter MARGIN(VARE,M,C);
MARGIN(VARE,M,C) = MARGIN_E(VARE,C);

* Calibrate margins to ensure zero-profits in the wholesale and retail sectors
MARGIN(VARE,M,'WHLS') = 0;
MARGIN(VARE,M,'FIND') = 0;
*
*
$iftheni.Pmp %Pmp%==YES
MARGIN(VARE,M,'RETL') = 0;
$endif.Pmp

$iftheni.Pmp %Pmp%==NO

Parameter MARGINCalib(VARE,M,C);
$gdxin pmp.gdx
$onMulti
$load MarginCalib=Margin
* calibrate margins to avoid low negative values
MARGIN(VARE,M,'RETL') =      MARGINCalib(VARE,M,'RETL');
$load StartVerdierMarket
$offMulti
StartVerdierMarket('xqs',VARE,'',M) = 0;
$endif.Pmp

*abort margin;
*
* Modellering av moelleprosesser
* Source: Animalia 2024
TABLE MOLDATA_E(VARE,MOEL) Input til moelleprosesser
      HVEM    RUGM    BYGM    HAVM    AKRM   RAPM   ERTM   FDRM    FDRA    FSVN    FEGG   FKYL      
HVEM  1.363
RUGM          1.363
BYGM                  1.363
HAVM                          1.363
AKRM                                  1.363
RAPM                                         1.363
ERTM                                                1.363
FMKN                                                       0.026   0.110   0.111   0.209  0.136
FFKN                                                       0.469   0.499   0.522   0.292  0.250
FSOY                                                       0.049   0.021   0.044   0.109  0.066
FBLG                                                       0.186   0.157   0.220   0.151  0.339 
FANT                                                       0.271   0.213   0.103   0.240  0.209
;
*
** Introduce gras protein ONLY if gras protein is present
* Otherwise the conventional process is damaged
** !! Include costs below !!
*MOLDATA_E('FBLG','FSVN') = 0.071;
*MOLDATA_E('FMKN','FSVN') = 0.030;
*MOLDATA_E('FFKN','FSVN') = 0.514;
*MOLDATA_E('FGRP','FSVN') = 0.036;
*MOLDATA_E('FANT','FSVN') = 0.347;
*
*
PARAMETER MOLDATA(*,MOEL) Koeffisienter i moelleprosesser;
MOLDATA(VARE,MOEL) $ MOLDATA_E(VARE,MOEL) = MOLDATA_E(VARE,MOEL);
*
MOLDATA('FDRM','FDRM') = 1.000;
MOLDATA('FDRA','FDRA') = 1.000;
MOLDATA('FSVN','FSVN') = 1.000;
MOLDATA('FEGG','FEGG') = 1.000;
MOLDATA('FKYL','FKYL') = 1.000;

PARAMETER MOLUTDATA(VARE,MOEL) Output fra moelleprosesser;
MOLUTDATA(VARE,MOEL) $ (SLTVARE(VARE) $ MOLDATA_E(VARE,MOEL)) = 1;

* Kalibrering foredlingskostnad til TOTPRIS24
* Kraftffôrpris minus råvarekostnader
MOLDATA('PRIS',MOEL) $ KMOEL(MOEL) = DATA('011101','FDRM','TOTP','BAS')
- MOLDATA('FMKN',MOEL) * DATA('011101','HVEF','TOTP','BAS')
- MOLDATA('FFKN',MOEL) * DATA('011101','BYGF','TOTP','BAS')
- MOLDATA('FSOY',MOEL) * (PI('FSOY')+KVOTETOLLA('FSOY'))
- MOLDATA('FBLG',MOEL) * DATA('011101','RAPF','TOTP','BAS')
- MOLDATA('FANT',MOEL) * (PI('FANT')+KVOTETOLLA('FANT'));

* Calibration of feed concentrate processing costs
MOLDATA('PRIS','FDRM') = MOLDATA('PRIS','FDRM') * 1;
MOLDATA('PRIS','FDRA') = MOLDATA('PRIS','FDRA') * 1;
MOLDATA('PRIS','FSVN') = MOLDATA('PRIS','FSVN') * 1;
MOLDATA('PRIS','FKYL') = MOLDATA('PRIS','FKYL') * 1;
MOLDATA('PRIS','FEGG') = MOLDATA('PRIS','FEGG') * 1;
*
* Introduction of cereal processing costs as 50 percent for difference between price difference mill and consumer
MOLDATA('PRIS','HVEM') = .5 * (P0_Org('HVEM','RETL') - DATA('011101','HVEM','TOTP','BAS') * MOLDATA('HVEM','HVEM')) ;
MOLDATA('PRIS','RUGM') = .5 * (P0_Org('RUGM','RETL') - DATA('011101','RUGM','TOTP','BAS') * MOLDATA('RUGM','RUGM')) ;
MOLDATA('PRIS','BYGM') = .5 * (P0_Org('BYGM','RETL') - DATA('011101','BYGM','TOTP','BAS') * MOLDATA('BYGM','BYGM')) ;
MOLDATA('PRIS','HAVM') = .5 * (P0_Org('HAVM','RETL') - DATA('011101','HAVM','TOTP','BAS') * MOLDATA('HAVM','HAVM')) ;
MOLDATA('PRIS','AKRM') = .5 * (P0_Org('AKRM','RETL') - DATA('011101','AKRM','TOTP','BAS') * MOLDATA('AKRM','AKRM')) ;
MOLDATA('PRIS','RAPM') = .5 * (P0_Org('RAPM','RETL') - DATA('011101','RAPM','TOTP','BAS') * MOLDATA('RAPM','RAPM')) ;
MOLDATA('PRIS','ERTM') = .5 * (P0_Org('ERTM','RETL') - DATA('011101','ERTM','TOTP','BAS') * MOLDATA('ERTM','ERTM')) ;
*
* Include costs of gras protein in processing costs
MOLDATA('PRIS',MOEL) = MOLDATA('PRIS',MOEL)  + MOLDATA('FGRP',MOEL) * DATA('011101','FGRP','TOTP','BAS');
*
* Fremskriving MOLDATA
MOLDATA('PRIS',MOEL) = MOLDATA('PRIS',MOEL)  * (1 + KPI)  ** (Y - %BAS%);
*
* Initiering av kostnader moeller
SIMDATA(M,MOEL,'PRIS','Y') = MOLDATA('PRIS',MOEL);
*
* Foredling av fjørfekjøtt
PARAMETER KYLDATA(VARE,PRDK);
* KHEL Hel kylling
KYLDATA('KHEL','KHEL') =  0.700;
KYLDATA('LONN','KHEL') =  3.600;
KYLDATA('AVAR','KHEL') =  4.020;
KYLDATA('FJRK','KHEL') =  1.000;
*
* KFIL Kyllingfilet
KYLDATA('KFIL','KFIL') =  0.222;
KYLDATA('KANT','KFIL') =  0.458;
KYLDATA('LONN','KFIL') =  8.600;
KYLDATA('AVAR','KFIL') =  5.020;
KYLDATA('ANNT','KFIL') =  5.000;
KYLDATA('FJRK','KFIL') =  1.000;
*
* KANT Annen kylling
KYLDATA('KANT','KANT') =  0.680;
KYLDATA('LONN','KANT') =  8.600;
KYLDATA('AVAR','KANT') = 11.020;
KYLDATA('ANNT','KANT') = 10.000;
KYLDATA('FJRK','KANT') =  1.000;
*
* Kalibrering KYLDATA
KYLDATA('LONN',PRDK) = KYLDATA('LONN',PRDK) * .25;
KYLDATA('ANNT',PRDK) = KYLDATA('ANNT',PRDK) * .25;
KYLDATA('AVAR',PRDK) = KYLDATA('AVAR',PRDK) * .25;
*
* Fremskriving KYLDATA
* Fremskriving LONN ANNT og AVAR
KYLDATA('LONN',PRDK) = KYLDATA('LONN',PRDK) * (1 + KPI + LOENN - VEKSTINDE/100) ** (Y - %BAS%);
KYLDATA('ANNT',PRDK) = KYLDATA('ANNT',PRDK) * (1 + KPI         - VEKSTINDE/100) ** (Y - %BAS%);
KYLDATA('AVAR',PRDK) = KYLDATA('AVAR',PRDK) * (1 + KPI         - VEKSTINDE/100) ** (Y - %BAS%);
*
* Beregning av transportkostnader og transporttid for slakterimodellen
PARAMETERS TRAVS(M,MM) Transportavstand mellom markedsregioner i km
           TRTID(M,MM) Transporttid mellom markedsregioner i min
           TRAVSKOST(VARE) Avstandsavhengig transportkostnad i kr pr km
           TRTIDKOST(VARE) Tidsavhengig transportkostnad i kr pr min
           TRSTPKOST(VARE) Laste og lossekostnad i kr pr stopp
           TRBILSTOR(VARE) Stoerrelse av lastebilen i kg
           TRKOST(VARE,M,MM) Transportkostnad mellom markedsregioner i kr per kg
           TRKOSTEKS(VARE,M) Transportkostnad fra markedsregion til utshippingshavn i kr per kg
           TRKOSTIMP(VARE,M) Transportkostnad fra innshippingshavn til markedsregioner i kr per kg
           AREAL(M)          Effektiv landareal i kvadratkm
           AREALKNST(M)      Konstant landareal i kvadratkm
           AREALPROD(M)      Landareal pr produsent i kvadratkm
           TRVEIANDEL(M) Andel E-R-F veier
;
TRAVS('OEST','SOER') = 510.1;
TRAVS('OEST','VEST') = 480.4;
TRAVS('OEST','MIDT') = 497.5;
TRAVS('OEST','NORD') = 1642.0;
TRAVS('SOER','VEST') = 190.3;
TRAVS('SOER','MIDT') = 837.9;
TRAVS('SOER','NORD') = 1982.4;
TRAVS('VEST','MIDT') = 634.7;
TRAVS('VEST','NORD') = 1779.2;
TRAVS('MIDT','NORD') = 1147.7;
*
TRAVS(M,MM) $ (TRAVS(M,MM) EQ 0) = TRAVS(MM,M);
*
TRTID('OEST','SOER') = 443.0;
TRTID('OEST','VEST') = 425.0;
TRTID('OEST','MIDT') = 422.0;
TRTID('OEST','NORD') = 1365.0;
TRTID('SOER','VEST') = 252.0;
TRTID('SOER','MIDT') = 749.0;
TRTID('SOER','NORD') = 1692.0;
TRTID('VEST','MIDT') = 557.0;
TRTID('VEST','NORD') = 1501.0;
TRTID('MIDT','NORD') = 947.0;
*
TRTID(M,MM) $ (TRTID(M,MM) EQ 0) = TRTID(MM,M);
*
*TRAVSKOST(VARE) Avstandsavhengig transportkostnad i kr pr km
TRAVSKOST(LDYR) = 5.03;
TRAVSKOST(FLYT) = 5.68;
TRAVSKOST(BULK) = 5.98;
TRAVSKOST(TERM) = 5.64;
*
*TRTIDKOST(VARE) Tidsavhengig transportkostnad i kr pr min
TRTIDKOST(LDYR) = 372.91/60;
TRTIDKOST(FLYT) = 532.87/60;
TRTIDKOST(BULK) = 454.41/60;
TRTIDKOST(TERM) = 485.31/60;
*
*TRSTPKOST(VARE) Laste og lossekostnad i kr pr stopp
TRSTPKOST(LDYR) = 469;
TRSTPKOST(FLYT) = 18;
TRSTPKOST(BULK) = 27;
TRSTPKOST(TERM) = 526;
*
TRBILSTOR(LDYR) = 30000;
TRBILSTOR(FLYT) = 31800;
TRBILSTOR(BULK) = 33400;
TRBILSTOR(TERM) = 24000;
*
* Fremskrivning 2004 til '2021'
* SSB KPI for godstransport paa vei 4K2004 til 1K2021-4K2023
TRAVSKOST(VARE) = TRAVSKOST(VARE) * 129.6 / 79.9;
TRTIDKOST(VARE) = TRTIDKOST(VARE) * 129.6 / 79.9;
TRSTPKOST(VARE) = TRSTPKOST(VARE) * 129.6 / 79.9;
*
* Update from 2021 to 2024
* Source: Tabell 12535... xlsx
TRAVSKOST(VARE) = TRAVSKOST(VARE) * 119.0083 / 93.25417;
TRTIDKOST(VARE) = TRTIDKOST(VARE) * 119.0083 / 93.25417;
TRSTPKOST(VARE) = TRSTPKOST(VARE) * 119.0083 / 93.25417;

* Kalibrering til '2014' med utgangspunkt i inntransport slakt
TRAVSKOST(LDYR) = TRAVSKOST(LDYR) * 4.5;
TRTIDKOST(LDYR) = TRTIDKOST(LDYR) * 4.5;
TRSTPKOST(LDYR) = TRSTPKOST(LDYR) * 1;
*
* Kalibrering transport flytende melk
TRAVSKOST(FLYT) = TRAVSKOST(FLYT) * .75;
TRTIDKOST(FLYT) = TRTIDKOST(FLYT) * .75;
TRSTPKOST(FLYT) = TRSTPKOST(FLYT) * 1;
*
* Projection KOST
TRAVSKOST(VARE) = TRAVSKOST(VARE) * (1 + KPI) ** (Y - %BAS%);
TRTIDKOST(VARE) = TRTIDKOST(VARE) * (1 + LOENN) ** (Y - %BAS%);
TRSTPKOST(VARE) = TRSTPKOST(VARE) * (1 + KPI) ** (Y - %BAS%);
*
TRAVSKOST(VARE) = TRAVSKOST(VARE) * (1 - VEKSTIND/100) ** (Y - %BAS%);
TRTIDKOST(VARE) = TRTIDKOST(VARE) * (1 - VEKSTIND/100) ** (Y - %BAS%);
TRSTPKOST(VARE) = TRSTPKOST(VARE) * (1 - VEKSTIND/100) ** (Y - %BAS%);
*
TRKOST(LDYR,M,MM) = (TRAVS(M,MM)*TRAVSKOST(LDYR) + TRTID(M,MM)*TRTIDKOST(LDYR) + 2 * TRSTPKOST(LDYR)) / TRBILSTOR(LDYR);
TRKOST(FLYT,M,MM) = (TRAVS(M,MM)*TRAVSKOST(FLYT) + TRTID(M,MM)*TRTIDKOST(FLYT) + 2 * TRSTPKOST(FLYT)) / TRBILSTOR(FLYT);
TRKOST(BULK,M,MM) = (TRAVS(M,MM)*TRAVSKOST(BULK) + TRTID(M,MM)*TRTIDKOST(BULK) + 2 * TRSTPKOST(BULK)) / TRBILSTOR(BULK);
TRKOST(TERM,M,MM) = (TRAVS(M,MM)*TRAVSKOST(TERM) + TRTID(M,MM)*TRTIDKOST(TERM) + 2 * TRSTPKOST(TERM)) / TRBILSTOR(TERM);
*
TRKOST(VARE,M,MM) $ (TRKOST(VARE,M,MM) EQ 0) = TRKOST(VARE,MM,M);
*
* Havn for import og eksport er Oslo
TRKOSTEKS(LDYR,M) = TRKOST(LDYR,M,'OEST');
TRKOSTEKS(FLYT,M) = TRKOST(FLYT,M,'OEST');
TRKOSTEKS(BULK,M) = TRKOST(BULK,M,'OEST');
TRKOSTEKS(TERM,M) = TRKOST(TERM,M,'OEST');
*
TRKOSTIMP(VARE,M) = TRKOSTEKS(VARE,M);
*
AREAL('OEST') =  108036 ;
AREAL('SOER') =   73807 ;
AREAL('VEST') =   72219 ;
AREAL('MIDT') =  111445 ;
AREAL('NORD') =  270593 ;
*
TRVEIANDEL('OEST') =  0.5385;
TRVEIANDEL('SOER') =  0.4072;
TRVEIANDEL('VEST') =  0.3884;
TRVEIANDEL('MIDT') =  0.4295;
TRVEIANDEL('NORD') =  0.3500;
*

* Market regulation fee for other products than dairy and meat
* Source: markedsdata.xslx
* see also: Market regulation agency (Omsetningsraadet. 2025. Annual report 2024)
OMSET('FJRK') = 0.2616;
OMSET('EGGS') = 0.2740;
OMSET(REGKornOljeVARE) = 0.0274;

* Fremskriving OMSET
OMSET(HAGE) = OMSET(HAGE)                       * (1 + KPI) ** (Y - %BAS%);
OMSET('FJRK') = OMSET('FJRK')                   * (1 + KPI) ** (Y - %BAS%);
OMSET('EGGS') = OMSET('EGGS')                   * (1 + KPI) ** (Y - %BAS%);
OMSET(REGKornOljeVARE) = OMSET(REGKornOljeVare) * (1 + KPI) ** (Y - %BAS%);
