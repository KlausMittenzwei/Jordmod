EGGS    -0.12697    -0.12697    -0.12697    -0.12697    -0.12697    -0.12697    -0.12697     -0.05416    -0.05416    -0.05416    -0.05416    -0.05416    -0.05416     0.16010     0.16010      0.16010    -0.20330     0.01134     0.01134    0.01134      0.01134     0.01134     0.35747     0.16010     -0.08016    0.11101     0.11101     0.11101     0.11101     0.11101     0.11101     0.11101     0.11101     0.11101     0.11101     0.11101     0.11101     0.11101     0.11101     0.11101     0.11101     0.11101     0.11101    -1.24545
;

PARAMETER ELAS(VARE,VAREVARE)  Ettersporselselastisiteter for sluttprodukter;

* Change sign to fit model specification
ELAS(VARE,VAREVARE) = -p_ELAS(VARE,VAREVARE);

*
* Manipulate cross-price elasticities
ELAS(VARE,VAREVARE) $ (DemKorn(VARE) AND (NOT SAMEAS(VARE,VAREVARE))) = 0.5 * ELAS(VARE,VAREVARE) * P0(VARE) * X0TOT(VARE) / SUM(DemKorn, P0(DemKorn) * X0TOT(DemKorn))
                                                                      + 0.5 * ELAS(VARE,VAREVARE) * 1 / CARD(DemKorn) ;
ELAS(VARE,VAREVARE) $ (DemHage(VARE) AND (NOT SAMEAS(VARE,VAREVARE))) = 0.5 * ELAS(VARE,VAREVARE) * P0(VARE) * X0TOT(VARE) / SUM(DemHage, P0(DemHage) * X0TOT(DemHage))
                                                                      + 0.5 * ELAS(VARE,VAREVARE) * 1 / CARD(DemHage) ;
ELAS(VARE,VAREVARE) $ (DemMelk(VARE) AND (NOT SAMEAS(VARE,VAREVARE))) = 0.5 * ELAS(VARE,VAREVARE) * P0(VARE) * X0TOT(VARE) / SUM(DemMelk, P0(DemMelk) * X0TOT(DemMelk))
                                                                      + 0.5 * ELAS(VARE,VAREVARE) * 1 / CARD(DemMelk) ;
ELAS(VARE,VAREVARE) $ (DemKjot(VARE) AND (NOT SAMEAS(VARE,VAREVARE))) = 0.5 * ELAS(VARE,VAREVARE) * P0(VARE) * X0TOT(VARE) / SUM(DemKjot, P0(DemKjot) * X0TOT(DemKjot))
                                                                      + 0.5 * ELAS(VARE,VAREVARE) * 1 / CARD(DemKjot) ;

* Manipulate cross-price elasticities for cereals to avoid negative consumer welfare
ELAS(VARE,VAREVARE) $ (DemKorn(VARE) AND (NOT SAMEAS(VARE,VAREVARE))) = .75 * ELAS(VARE,VAREVARE);

*abort elas;

PARAMETERS
        ALFA(VARE,M)          Ettersporselskonstant
        BETA(VARE,VAREVARE,M) Marginal ettersporselsmatrise
        invBETA(VARE,VAREVARE,M) Invers marginal ettersporselsmatrise
        BETAOest(SVARE,SSVARE) Marginal ettersporselsmatrise Oest
        BETAVest(SVARE,SSVARE) Marginal ettersporselsmatrise Vest
        BETASoer(SVARE,SSVARE) Marginal ettersporselsmatrise Soer
        BETAMidt(SVARE,SSVARE) Marginal ettersporselsmatrise Midt
        BETANord(SVARE,SSVARE) Marginal ettersporselsmatrise Nord
        ID(VARE,VARE)         Identitetsmatrise for slp med kryssprisvirkninger
;

        BETA(VARE,VAREVARE,M) $ ((P0(VARE) * P0(VAREVARE)) GT 0) = ELAS(VARE,VAREVARE)*
                            ((P0(VARE) * X0(VARE,M)) + (P0(VAREVARE)*X0(VAREVARE,M)))/
                            (2*P0(VARE)* P0(VAREVARE));
        ALFA(VARE,M) $ SVARE(VARE) = X0(VARE,M) + SUM(VAREVARE, P0(VAREVARE)*BETA(VARE,VAREVARE,M))                                  ;

        ID(VARE,VARE) $ SVARE(VARE) = 1;

        BETAOest(SVARE,SSVARE) = BETA(SVARE,SSVARE,'Oest') ;
        BETAVest(SVARE,SSVARE) = BETA(SVARE,SSVARE,'Vest') ;
        BETASoer(SVARE,SSVARE) = BETA(SVARE,SSVARE,'Soer') ;
        BETAMidt(SVARE,SSVARE) = BETA(SVARE,SSVARE,'Midt') ;
        BETANord(SVARE,SSVARE) = BETA(SVARE,SSVARE,'Nord') ;

variables
        invBETAOest(SVARE,SSVARE) Invers marginal ettersporselsmatrise Oest  
        invBETAVest(SVARE,SSVARE) Invers marginal ettersporselsmatrise Vest  
        invBETASoer(SVARE,SSVARE) Invers marginal ettersporselsmatrise Soer  
        invBETAMidt(SVARE,SSVARE) Invers marginal ettersporselsmatrise Midt  
        invBETANord(SVARE,SSVARE) Invers marginal ettersporselsmatrise Nord  
        dummy
;

equations
        equInvBETAOest(SVARE,SSVARE) Invers marginal ettersporselsmatrise Oest  
        equInvBETAVest(SVARE,SSVARE) Invers marginal ettersporselsmatrise Vest  
        equInvBETASoer(SVARE,SSVARE) Invers marginal ettersporselsmatrise Soer  
        equInvBETAMidt(SVARE,SSVARE) Invers marginal ettersporselsmatrise Midt  
        equInvBETANord(SVARE,SSVARE) Invers marginal ettersporselsmatrise Nord  
        equDummy
;

     equInvBETAOest(SVARE,SSVARE).. sum(SSSVare, invBETAOest(SVARE,SSSVARE) * BETAOest(SSSVARE,SSVARE)) =E= ID(SVARE,SSVARE);
     equInvBETAVest(SVARE,SSVARE).. sum(SSSVare, invBETAVest(SVARE,SSSVARE) * BETAVest(SSSVARE,SSVARE)) =E= ID(SVARE,SSVARE);
     equInvBETASoer(SVARE,SSVARE).. sum(SSSVare, invBETASoer(SVARE,SSSVARE) * BETASoer(SSSVARE,SSVARE)) =E= ID(SVARE,SSVARE);
     equInvBETAMidt(SVARE,SSVARE).. sum(SSSVare, invBETAMidt(SVARE,SSSVARE) * BETAMidt(SSSVARE,SSVARE)) =E= ID(SVARE,SSVARE);
     equInvBETANord(SVARE,SSVARE).. sum(SSSVare, invBETANord(SVARE,SSSVARE) * BETANord(SSSVARE,SSVARE)) =E= ID(SVARE,SSVARE);
     equDummy.. dummy =e= 0;
     
Model Mod_Inv /equInvBETAOest, equInvBETAVest, equInvBETASoer, equInvBETAMidt, equInvBETANord, equDummy /
;

solve Mod_inv using lp minimizing dummy;

     invBETA(SVARE,SSVARE,'Oest') = invBetaOest.l(SVARE,SSVARE); 
     invBETA(SVARE,SSVARE,'Vest') = invBetaVest.l(SVARE,SSVARE); 
     invBETA(SVARE,SSVARE,'Soer') = invBetaSoer.l(SVARE,SSVARE); 
     invBETA(SVARE,SSVARE,'Midt') = invBetaMidt.l(SVARE,SSVARE); 
     invBETA(SVARE,SSVARE,'Nord') = invBetaNord.l(SVARE,SSVARE); 

Parameter ConsKalibTest(VARE,*,*);

ConsKalibTest(VARE,M,'Kalib') = ALFA(VARE,M) - SUM(VAREVARE, P0(VAREVARE) * BETA(VARE,VAREVARE,M));
ConsKalibTest(VARE,M,'Obs')  = X0(VARE,M);
ConsKalibTest(VARE,'','Cnst') $ SUM(M, X0(VARE,M)) = SUM(M, ALFA(VARE,M) - SUM(VAREVARE$ (NOT SAMEAS(VARE,VAREVARE)), P0(VAREVARE) * BETA(VARE,VAREVARE,M)));
ConsKalibTest(VARE,'','Marg') $ SUM(M, X0(VARE,M)) = SUM(M, BETA(VARE,VARE,M) * X0(VARE,M)) / SUM(M, X0(VARE,M));
ConsKalibTest(VARE,'','X0') $ SUM(M, X0(VARE,M)) = SUM(M, X0(VARE,M));
ConsKalibTest(VARE,'','P0') $ SUM(M, X0(VARE,M)) = SUM(M, P0(VARE) * X0(VARE,M)) / SUM(M, X0(VARE,M));

execute_unload 'elas.gdx', elas, alfa, beta, invBeta, X0, P0, ConsKalibTest;
*abort '';
*

Sets
MarginLo(VARE) Products with margins less than 10 percent of consumer price
MarginHi(VARE) Products with margins higher than 10 percent of consumer price
;

Parameter
MarginL(VARE,M) Calibrated processing margin
MarginP(VARE,M) Equilibrium price


