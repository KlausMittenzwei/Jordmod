KANT     45.5686 
/;

* Calibration some products to fit with domestic production
X0TOT('POTE') = MAX(X0TOT('POTE'), Data('Norge','POTE','MNGD','BAS'));

* Calibration some products to avoid imports through full tariffs
X0TOT(VARE) $ MEIVARE(VARE) = X0TOT(VARE) * 0.815;
X0TOT(VARE) $ (SLKVARE(VARE) $ SLTVARE(VARE)) = X0TOT(VARE) * 0.89;
*    
* Calibration some products to avoid exports
X0TOT('KHEL') = X0TOT('KHEL') * 1.05;
X0TOT('KFIL') = X0TOT('KFIL') * 1.05;
X0TOT('KANT') = X0TOT('KANT') * 1.05;
*
* Befolkning (mill)
* Source: Markedsdata.xlsx
SCALAR POPBAS/ 5.544509/;
*
* Source: Markedsdata.xlsx
PARAMETER X0ANDEL(M)   Konsumandeler i markedsregionene
/
$ifThenI.PopBas %SIMYEAR%==NO
OEST     0.4761   
SOER     0.2372   
VEST     0.0498   
MIDT     0.1508   
NORD     0.0860   
$endif.PopBas

$ifThenI.PopSim %SIMYEAR%==YES
OEST     0.4948     
SOER     0.2378     
VEST     0.0460     
MIDT     0.1449     
NORD     0.0765     
$endif.PopSim

/;
*
*
PARAMETER VERDIANDEL(VARE) Forbruksandel matvarer på verdibasis;
VERDIANDEL(VARE) $ P0(VARE) = (P0(VARE) * X0TOT(VARE)) / SUM(VAREVARE, P0(VAREVARE) * X0TOT(VAREVARE));
*
* Kalibrert som differanse mellom PO og totprisbas
* Assume margins at 10% of P0
PARAMETER FK(VARE,M)     Eksogene foredlingskostnader (kr per kg);
FK(VARE,M) $ EFKVARE(VARE) = .9 * (P0(VARE)
                           - DATA('NORGE',VARE,'TOTP','BAS') $      DATA('NORGE',VARE,'MNGD','BAS')
                           - (PI(VARE) + KVOTETOLLA(VARE))   $ (NOT DATA('NORGE',VARE,'MNGD','BAS')));

* Projection of exogenous processing costs
FK(EFKVARE,M) = FK(EFKVARE,M)  * (1 + KPI) * (1 - VEKSTINDE/100)  ** (Y - %BAS%);
*
PARAMETER X0(VARE,M)   Basismengde for markedsregion i 2021 ;
X0(VARE,M) = X0TOT(VARE)*X0ANDEL(M);

* Projection of human consumption with population development
X0(VARE,M) = X0(VARE,M) * (1 + POP) ** (Y - %BAS%);
*
* Projection of human consumption with per capita development
X0(VARE,M) $ (DemKorn(VARE) AND SLTVARE(VARE)) = X0(VARE,M) * (1.000148) ** (Y - %BAS%);
X0(VARE,M) $ (HAGE(VARE) AND SLTVARE(VARE))    = X0(VARE,M) * (1.002209) ** (Y - %BAS%);
X0(VARE,M) $ SAMEAS("POTE",VARE)               = X0(VARE,M) * (1.010179) ** (Y - %BAS%);
X0(VARE,M) $ (RKJOETT(VARE) AND SLTVARE(VARE)) = X0(VARE,M) * (0.999945) ** (Y - %BAS%);
*
* This info is used in dairy and meat moduldes
SIMDATA(M,VARE,'MNGD','BAS') $ SLTVARE(VARE) = X0(VARE,M);
SIMDATA(M,VARE,'MNGD','Y')   $ SLTVARE(VARE) = X0(VARE,M);

************************************************
* 
* Kalibrering administrativt potetimport
POL('NORGE','POTE','ADMIMPT') =  MAX(0, X0TOT('POTE') - DATA('NORGE','POTE','MNGD','BAS'))  ;
KVOTETOLLA('POTE') = MAX(0, MIN[TOLL('POTE'),DATA('NORGE','POTE','TOTP','BAS') - PI('POTE')]);
*
* Sesongmessig import av GRNS og FRBA til norsk pris
* Sikre at verdensmarkedspris pluss MFN toll ikke er h�yere enn norsk pris
PI(HAGE) = MAX[PI(HAGE),DATA('NORGE',HAGE,'TOTP','BAS')-TOLL(HAGE)];
POL('NORGE',HAGE,'ADMIMPT') =  X0TOT(HAGE) - DATA('NORGE',HAGE,'MNGD','BAS')  ;
KVOTETOLLA(HAGE) = MAX{0, MIN[TOLL(HAGE),DATA('NORGE',HAGE,'TOTP','BAS') - PI(HAGE)]};

Parameter VmData(*,VARE);
VmData('pNorsk',VARE) = DATA('NORGE',VARE,'TOTP','BAS');
VmData('pi',VARE) = PI(VARE);
VmData('pe',VARE) = PE(VARE);
VmData('toll',VARE) = Toll(VARE);
VmData('krtoll',VARE) = KroneToll(VARE);
VmData('Prtoll',VARE) = ProsentToll(VARE);
VmData('kvotetoll',VARE) = Kvotetoll(VARE);
VmData('kvotetolla',VARE) = Kvotetolla(VARE);
VmData('kvotetollb',VARE) = Kvotetollb(VARE);
VmData('kvotetolls',VARE) = Kvotetolls(VARE);

execute_unload 'markedsmodul\VmData.gdx' VmData, Pol; 
